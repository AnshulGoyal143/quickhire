<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin - User Details</title>

    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.6.0/fonts/remixicon.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-gray-50 overflow-x-hidden">

    <div class="min-h-screen">

        <!-- ================= NAVBAR ================= -->

      <nav class="w-full h-16 bg-gray-100 flex items-center justify-between px-3 py-2 fixed top-0">
                <div class="flex items-center justify-between sm:gap-4 lg:gap-6">
                    <div class="menubtn">
                        <i class="ri-menu-fill text-2xl"></i>
                    </div>
                    <h2 class="text-lg md:text-xl font-semibold text-gray-800 ml-2">Dashboard</h2>
                </div>
                <div class="flex items-center gap-6">
                    <!-- notification k ley route bnana h -->
                    <a href=""><i class="ri-notification-3-line text-2xl"></i>
                    </a>
                     <div class="flex items-center gap-2">

                        <div
                            class="h-11 w-11 rounded-full overflow-hidden bg-blue-100 flex items-center justify-center">

                            <% if (admin?.profileImage &&
                                admin.profileImage !== "default-admin.png") { %>

                                <img src="/admin/admin-profile"
                                    alt="Admin Profile"
                                    class="w-full h-full object-cover">

                                <% } else { %>

                                    <i class="ri-admin-fill text-2xl text-blue-500"></i>

                                    <% } %>

                        </div>

                        <h2 class="text-xl font-semibold hidden md:block text-gray-800">
                            Admin
                        </h2>

                        <a href="">
                            <i class="ri-arrow-down-wide-line text-gray-600"></i>
                        </a>

                    </div>
                </div>
            </nav>
            <!-- *********** FOr the menu list div ********-->
            <div
                class=" sidebar fixed top-0 left-0 w-72 h-screen bg-white shadow-2xl z-50 -translate-x-full transition-transform duration-300 p-4">

                <div class="flex items-center ">
                    <img class="h-8"
                        src="https://static.vecteezy.com/system/resources/thumbnails/070/916/787/small/a-3d-render-of-a-light-blue-briefcase-with-the-word-job-in-white-letters-isolated-on-transparent-background-png.png"
                        alt="">
                    <h5 class="text-xl font-bold">Quick <span class="text-blue-500">Hire</span></h5>
                </div>

                <div class="cross flex justify-end mb-3">
                    <i
                        class="ri-close-line text-2xl w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center cursor-pointer hover:bg-gray-200"></i>
                </div>
                <div class="list">
                    <ul class=" space-y-3">
                        <!-- yha pee user dashboard menu link attach krne h -->

                        <li class="flex items-center gap-2 px-4 py-3 rounded-xl cursor-pointer hover:bg-gray-100  mb-1">
                            <a href="/admin/adminDashboard">
                                <i class="ri-home-3-line text-xl"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>


                        <li
                            class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer bg-blue-100 text-blue-600 ">
                            <a href="/admin/adminUserDashboard">
                                <i class="ri-group-line text-xl"></i>
                                <span>Users</span>
                            </a>
                        </li>


                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">
                            <a href="/admin/adminCompanyDashboard">
                                <i class="ri-building-2-line text-xl"></i>
                                <span>Companies</span>
                            </a>
                        </li>


                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">
                            <a href="/admin/adminJobDashboard">
                                <i class="ri-briefcase-4-line text-xl"></i>
                                <span>Jobs</span>
                            </a>
                        </li>


                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">
                            <a href="/admin/adminApplications">
                                <i class="ri-file-list-3-line text-xl"></i>
                                <span>Applications</span>
                            </a>
                        </li>

                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100 ">
                            <a href="/admin/adminProfilePage">
                                <i class="ri-group-line text-xl"></i>
                                <span>My Profile</span>
                            </a>
                        </li>

                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer mt-8 hover:bg-gray-100">
                            <a href="/admin/logout">
                                <i class="ri-logout-box-r-line text-xl"></i>
                                <span>Logout</span>
                            </a>
                        </li>


                    </ul>
                </div>
            </div>

        <!-- OVERLAY -->

        <div class="overlay fixed inset-0 bg-black/40
                    hidden z-40"></div>



        <!-- ================= MAIN ================= -->

        <main class="pt-24 pb-12 px-4 sm:px-6 lg:px-10">


            <!-- BACK BUTTON -->

            <div class="mb-6">

                <a href="/admin/adminUserDashboard"
                   class="inline-flex items-center gap-2
                          text-gray-600 hover:text-blue-600
                          transition">

                    <i class="ri-arrow-left-line"></i>

                    Back to Users

                </a>

            </div>



            <!-- PAGE HEADING -->

            <div class="flex flex-col md:flex-row
                        md:items-center md:justify-between
                        gap-4 mb-8">

                <div>

                    <h1 class="text-3xl md:text-4xl
                               font-bold text-gray-800">

                        User Details

                    </h1>

                    <p class="text-gray-500 mt-2">

                        View and manage complete user information

                    </p>

                </div>


                <!-- DELETE BUTTON -->

                <button
                    onclick="openDeleteModal()"
                    class="inline-flex items-center justify-center
                           gap-2 px-5 py-3 rounded-xl
                           bg-red-500 text-white
                           hover:bg-red-600 transition
                           shadow-sm">

                    <i class="ri-delete-bin-6-line"></i>

                    Delete User

                </button>

            </div>



            <!-- ================= PROFILE CARD ================= -->

            <div class="bg-white rounded-3xl
                        border border-gray-200 shadow-lg
                        p-6 md:p-8 mb-6">

                <div class="flex flex-col md:flex-row
                            items-center md:items-start
                            gap-6">


                    <!-- PROFILE IMAGE -->

                    <div class="w-32 h-32 rounded-2xl
                                bg-blue-50
                                overflow-hidden
                                border-4 border-white
                                shadow-md
                                flex items-center justify-center">

                        <% if (user.profileImage && user.profileImage.data) { %>

                            <img
                                src="data:<%= user.profileImage.contentType %>;base64,<%= user.profileImage.data.toString('base64') %>"
                                alt="User Profile"
                                class="w-full h-full object-cover">

                        <% } else { %>

                            <div class="w-full h-full
                                        flex items-center justify-center
                                        bg-blue-50">

                                <i class="ri-user-3-line
                                          text-5xl text-blue-400"></i>

                            </div>

                        <% } %>

                    </div>



                    <!-- BASIC DETAILS -->

                    <div class="flex-1 text-center md:text-left">

                        <div class="flex flex-col md:flex-row
                                    md:items-center gap-3">

                            <h2 class="text-2xl md:text-3xl
                                       font-bold text-gray-800">

                                <%= user.fullname %>

                            </h2>

                            <span class="w-fit mx-auto md:mx-0
                                         px-3 py-1 rounded-full
                                         bg-green-100 text-green-600
                                         text-sm font-medium">

                                Active User

                            </span>

                        </div>


                        <p class="text-blue-600 font-medium mt-2">

                            Job Seeker

                        </p>


                        <div class="flex flex-col sm:flex-row
                                    gap-3 sm:gap-6
                                    mt-4 text-gray-600">

                            <p class="flex items-center
                                      justify-center md:justify-start
                                      gap-2">

                                <i class="ri-mail-line text-blue-500"></i>

                                <%= user.email %>

                            </p>


                            <p class="flex items-center
                                      justify-center md:justify-start
                                      gap-2">

                                <i class="ri-phone-line text-blue-500"></i>

                                <%= user.mobile %>

                            </p>

                        </div>

                    </div>

                </div>

            </div>



            <!-- ================= PERSONAL + PROFESSIONAL ================= -->

            <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">


                <!-- PERSONAL INFORMATION -->

                <div class="bg-white rounded-3xl
                            border border-gray-200
                            shadow-lg p-7">

                    <div class="flex items-center gap-3 mb-7">

                        <div class="w-11 h-11 rounded-xl
                                    bg-blue-50
                                    flex items-center justify-center">

                            <i class="ri-user-3-line
                                      text-blue-600 text-xl"></i>

                        </div>

                        <h2 class="text-2xl font-semibold text-gray-800">

                            Personal Information

                        </h2>

                    </div>


                    <div class="grid grid-cols-1 md:grid-cols-2">


                        <div class="py-4 border-b border-gray-200">

                            <p class="text-sm text-gray-500">
                                Full Name
                            </p>

                            <p class="font-semibold text-gray-800 mt-1">
                                <%= user.fullname %>
                            </p>

                        </div>


                        <div class="py-4 border-b border-gray-200 md:pl-8">

                            <p class="text-sm text-gray-500">
                                Username
                            </p>

                            <p class="font-semibold text-gray-800 mt-1">
                                @<%= user.username %>
                            </p>

                        </div>


                        <div class="py-4 border-b border-gray-200">

                            <p class="text-sm text-gray-500">
                                Date of Birth
                            </p>

                            <p class="font-semibold text-gray-800 mt-1">

                                <%= user.dob
                                    ? user.dob.toISOString().split('T')[0]
                                    : "Not Provided" %>

                            </p>

                        </div>


                        <div class="py-4 border-b border-gray-200 md:pl-8">

                            <p class="text-sm text-gray-500">
                                Gender
                            </p>

                            <p class="font-semibold text-gray-800 mt-1">

                                <%= user.gender || "Not Provided" %>

                            </p>

                        </div>


                        <div class="py-4 border-b border-gray-200">

                            <p class="text-sm text-gray-500">
                                Email
                            </p>

                            <p class="font-semibold text-gray-800 mt-1 break-all">

                                <%= user.email %>

                            </p>

                        </div>


                        <div class="py-4 border-b border-gray-200 md:pl-8">

                            <p class="text-sm text-gray-500">
                                Mobile
                            </p>

                            <p class="font-semibold text-gray-800 mt-1">

                                <%= user.mobile || "Not Provided" %>

                            </p>

                        </div>


                        <div class="py-4 border-b border-gray-200
                                    md:col-span-2">

                            <p class="text-sm text-gray-500">
                                Address
                            </p>

                            <p class="font-semibold text-gray-800 mt-1">

                                <%= user.address || "Not Provided" %>

                            </p>

                        </div>


                        <div class="py-4">

                            <p class="text-sm text-gray-500">
                                City
                            </p>

                            <p class="font-semibold text-gray-800 mt-1">

                                <%= user.city || "Not Provided" %>

                            </p>

                        </div>


                        <div class="py-4 md:pl-8">

                            <p class="text-sm text-gray-500">
                                State
                            </p>

                            <p class="font-semibold text-gray-800 mt-1">

                                <%= user.state || "Not Provided" %>

                            </p>

                        </div>


                        <div class="py-4">

                            <p class="text-sm text-gray-500">
                                Pincode
                            </p>

                            <p class="font-semibold text-gray-800 mt-1">

                                <%= user.pincode || "Not Provided" %>

                            </p>

                        </div>

                    </div>

                </div>



                <!-- PROFESSIONAL INFORMATION -->

                <div class="bg-white rounded-3xl
                            border border-gray-200
                            shadow-lg p-7">

                    <div class="flex items-center gap-3 mb-7">

                        <div class="w-11 h-11 rounded-xl
                                    bg-blue-50
                                    flex items-center justify-center">

                            <i class="ri-briefcase-4-line
                                      text-blue-600 text-xl"></i>

                        </div>

                        <h2 class="text-2xl font-semibold text-gray-800">

                            Professional Information

                        </h2>

                    </div>


                    <div>

                        <h3 class="font-semibold text-gray-800 mb-4">

                            Skills

                        </h3>


                        <div class="flex flex-wrap gap-3">

                            <% if (user.skills && user.skills.length > 0) { %>

                                <% user.skills.forEach(skill => { %>

                                    <span class="px-4 py-2
                                                 rounded-full
                                                 bg-blue-50
                                                 text-blue-600
                                                 text-sm font-medium">

                                        <%= skill %>

                                    </span>

                                <% }) %>

                            <% } else { %>

                                <p class="text-gray-500">
                                    No skills added
                                </p>

                            <% } %>

                        </div>



                        <!-- ABOUT -->

                        <div class="mt-10">

                            <h3 class="font-semibold text-gray-800 mb-3">

                                About User

                            </h3>

                            <div class="bg-gray-50 rounded-2xl p-5">

                                <p class="text-gray-600 leading-7">

                                    <%= user.aboutme || "No information provided." %>

                                </p>

                            </div>

                        </div>

                    </div>

                </div>

            </div>



            <!-- ================= ACCOUNT INFORMATION ================= -->

            <div class="bg-white rounded-3xl
                        border border-gray-200
                        shadow-lg p-7 mt-6">

                <div class="flex items-center gap-3 mb-7">

                    <div class="w-11 h-11 rounded-xl
                                bg-blue-50
                                flex items-center justify-center">

                        <i class="ri-shield-check-line
                                  text-blue-600 text-xl"></i>

                    </div>

                    <h2 class="text-2xl font-semibold text-gray-800">

                        Account Information

                    </h2>

                </div>


                <div class="grid grid-cols-1 sm:grid-cols-2
                            lg:grid-cols-4 gap-6">


                    <div class="bg-gray-50 rounded-2xl p-5">

                        <p class="text-sm text-gray-500">
                            Account Type
                        </p>

                        <p class="font-semibold text-gray-800 mt-2">
                            User
                        </p>

                    </div>


                    <div class="bg-gray-50 rounded-2xl p-5">

                        <p class="text-sm text-gray-500">
                            Account Status
                        </p>

                        <p class="font-semibold text-green-600 mt-2">

                            Active

                        </p>

                    </div>


                    <div class="bg-gray-50 rounded-2xl p-5">

                        <p class="text-sm text-gray-500">
                            Member Since
                        </p>

                        <p class="font-semibold text-gray-800 mt-2">

                            <%= user.createdAt
                                ? user.createdAt.toDateString()
                                : "Not Available" %>

                        </p>

                    </div>


                    <div class="bg-gray-50 rounded-2xl p-5">

                        <p class="text-sm text-gray-500">
                            User ID
                        </p>

                        <p class="font-semibold text-gray-800
                                  mt-2 text-xs break-all">

                            <%= user._id %>

                        </p>

                    </div>

                </div>

            </div>



            <!-- ================= ADMIN ACTION ================= -->

            <div class="mt-6 bg-red-50 border border-red-200
                        rounded-3xl p-6">

                <div class="flex flex-col md:flex-row
                            md:items-center
                            md:justify-between gap-5">

                    <div class="flex items-start gap-4">

                        <div class="w-12 h-12 rounded-xl
                                    bg-red-100
                                    flex items-center justify-center
                                    flex-shrink-0">

                            <i class="ri-delete-bin-6-line
                                      text-red-500 text-xl"></i>

                        </div>

                        <div>

                            <h3 class="font-semibold text-red-700 text-lg">

                                Delete User Account

                            </h3>

                            <p class="text-sm text-red-600 mt-1">

                                Permanently remove this user from Quick Hire.

                            </p>

                        </div>

                    </div>


                    <button
                        onclick="openDeleteModal()"
                        class="px-5 py-3 bg-red-500
                               text-white rounded-xl
                               hover:bg-red-600 transition
                               flex items-center justify-center gap-2">

                        <i class="ri-delete-bin-line"></i>

                        Delete User

                    </button>

                </div>

            </div>

        </main>

    </div>



    <!-- ================= DELETE MODAL ================= -->

    <div id="deleteModal"
         class="fixed inset-0 z-[100]
                hidden items-center justify-center
                bg-black/50 px-4">

        <div class="bg-white rounded-3xl
                    shadow-2xl w-full max-w-md
                    p-7">


            <div class="w-14 h-14 rounded-2xl
                        bg-red-100
                        flex items-center justify-center
                        mx-auto">

                <i class="ri-delete-bin-6-line
                          text-red-500 text-2xl"></i>

            </div>


            <h2 class="text-xl font-bold
                       text-gray-800 text-center mt-5">

                Delete User?

            </h2>


            <p class="text-gray-500 text-center
                      mt-2 leading-6">

                Are you sure you want to delete

                <span class="font-semibold text-gray-800">
                    <%= user.fullname %>
                </span>?

                This action cannot be undone.

            </p>


            <div class="flex gap-3 mt-7">

                <button
                    onclick="closeDeleteModal()"
                    class="flex-1 px-4 py-3
                           rounded-xl border
                           border-gray-300
                           text-gray-700
                           hover:bg-gray-50">

                    Cancel

                </button>


                <a href="/admin/adminDeleteUser/<%= user._id %>"
                   class="flex-1 px-4 py-3
                          rounded-xl
                          bg-red-500 text-white
                          text-center
                          hover:bg-red-600">

                    Delete

                </a>

            </div>

        </div>

    </div>



    <!-- ================= JAVASCRIPT ================= -->

    <script>

        const menubtn = document.querySelector(".menubtn");
        const sidebar = document.querySelector(".sidebar");
        const cross = document.querySelector(".cross");
        const overlay = document.querySelector(".overlay");

        const deleteModal = document.querySelector("#deleteModal");


        // OPEN SIDEBAR

        menubtn.addEventListener("click", () => {

            sidebar.classList.remove("-translate-x-full");

            overlay.classList.remove("hidden");

        });


        // CLOSE SIDEBAR

        cross.addEventListener("click", () => {

            sidebar.classList.add("-translate-x-full");

            overlay.classList.add("hidden");

        });


        overlay.addEventListener("click", () => {

            sidebar.classList.add("-translate-x-full");

            overlay.classList.add("hidden");

        });


        // DELETE MODAL

        function openDeleteModal() {

            deleteModal.classList.remove("hidden");

            deleteModal.classList.add("flex");

        }


        function closeDeleteModal() {

            deleteModal.classList.add("hidden");

            deleteModal.classList.remove("flex");

        }


        // ESC KEY

        document.addEventListener("keydown", (e) => {

            if (e.key === "Escape") {

                closeDeleteModal();

            }

        });

    </script>

</body>

</html>