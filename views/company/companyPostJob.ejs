<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.6.0/fonts/remixicon.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="overflow-x-hidden">
    <div class="w-full min-h-screen relative">
        <div class="w-full min-h-screen relative bg-cover bg-center bg-no-repeat  inset-0"
            style="background-image: url('/public/images/WhatsApp\ Image\ 2026-07-09\ at\ 3.40.54\ PM.jpeg');">

            <div class="absolute inset-0 bg-white/80"></div>
            <div class="relative z-10 pt-24 ">

                <nav class="w-full h-16 bg-gray-100 flex items-center justify-between px-3 py-2 fixed top-0 z-30">
                    <div class="flex items-center justify-between sm:gap-4 lg:gap-6">
                        <div class="menubtn">
                            <i class="ri-menu-fill text-2xl"></i>
                        </div>
                        <h2 class="text-lg md:text-xl font-semibold text-gray-800 ml-2">My Profile</h2>
                    </div>
                    <div class="flex items-center gap-6">
                        <!-- notification k ley route bnana h -->
                        <a href=""><i class="ri-notification-3-line text-2xl"></i>
                        </a>
                        <div class="flex items-center gap-2">
                            <img class="h-10 w-11 rounded-full"
                                src="https://static.vecteezy.com/system/resources/thumbnails/053/964/117/small/a-silhouette-of-a-person-with-a-circular-head-and-a-minimalistic-body-structure-showcasing-a-simple-design-png.png"
                                alt="">
                            <h2 class="text-xl font-semibold hidden md:block ">Admin</h2>
                            <a href=""><i class="ri-arrow-down-wide-line"></i></a>
                        </div>
                    </div>
                </nav>
                <!-- *********** FOr the menu list div ********-->
                <div
                    class=" sidebar fixed top-0 left-0 w-72 h-screen bg-white shadow-2xl z-50 -translate-x-full transition-transform duration-300 p-4">

                    <div class="flex items-center ">
                        <img class="h-8"
                            src="https://static.vecteezy.com/system/resources/thumbnails/070/916/787/small/a-3d-render-of-a-light-blue-briefcase-with-the-word-job-in-white-letters-isolated-on-transparent-background-png.png"
                            alt="">
                        <h5 class="text-xl font-bold">Quick <span class="text-blue-500">Hire</span></h5>
                    </div>
                    <div class="cross flex justify-end ">
                        <i
                            class="ri-close-line text-2xl w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center cursor-pointer hover:bg-gray-200"></i>
                    </div>
                    <div class="list">
                        <ul class=" space-y-3">
                            <!-- yha pee user dashboard menu link attach krne h -->

                            <li
                                class="flex items-center gap-2 px-4 py-3 rounded-xl cursor-pointer hover:bg-gray-100  mb-1">
                                <a href="">
                                    <i class="ri-home-3-line text-xl"></i>
                                    <span>Dashboard</span>
                                </a>
                            </li>


                            <li
                                class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer bg-blue-100 text-blue-600  ">
                                <a href="">
                                    <i class="ri-group-line text-xl"></i>
                                    <span>My Profile</span>
                                </a>
                            </li>


                            <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">
                                <a href="">
                                    <i class="ri-file-add-line text-xl"></i>
                                    <span>Post a Job</span>
                                </a>
                            </li>

                            <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">
                                <a href="">
                                    <i class="ri-briefcase-4-line text-xl"></i>
                                    <span>Jobs Posts</span>
                                </a>
                            </li>


                            <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">
                                <a href="">
                                    <i class="ri-team-line text-xl"></i>
                                    <span>Applicants</span>
                                </a>
                            </li>


                            <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">
                                <a href="">
                                    <i class="ri-file-list-3-line text-xl"></i>
                                    <span>Applications</span>
                                </a>
                            </li>

                            <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">
                                <a href="">
                                    <i class="ri-bookmark-line text-xl"></i>
                                    <span>Saved Candidates</span>
                                </a>
                            </li>

                            <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">
                                <a href="">
                                    <i class="ri-chat-3-line text-xl"></i>
                                    <span>Messages</span>
                                </a>
                            </li>

                            <li
                                class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer mt-8 hover:bg-gray-100">
                                <a href="">
                                    <i class="ri-logout-box-r-line text-xl"></i>
                                    <span>Logout</span>
                                </a>
                            </li>


                        </ul>
                    </div>
                </div>

                <div class="overlay fixed inset-0 bg-black/30 hidden z-40"></div>


                <div class=" px-4 max-w-6xl mx-auto pb-12">
                    <h2 class="text-4xl font-bold mb-2 px-2">Post a New Job</h2>
                    <p class="text-gray-700 text-xl mb-5 px-2">Fill in the details below to create a new job posting</p>

                    <div class="bg-white shadow-lg rounded-3xl p-8 mt-6 pb-12">

                        <!-- ************ ********* -->
                        <form action="/company/PostJob" method="post">

                            <!-- ************ JOB DETAILS********* -->
                            <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">

                                <!-- Heading -->
                                <div class="flex items-center gap-3 mb-6">
                                    <div class="w-10 h-10 rounded-lg bg-blue-50 flex items-center justify-center">
                                        <i class="ri-add-box-line text-blue-600 text-xl"></i>
                                    </div>

                                    <h2 class="text-xl font-semibold text-gray-800">
                                        Job Details
                                    </h2>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">

                                    <!-- Job Title -->
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            Job Title <span class="text-red-500">*</span>
                                        </label>

                                        <input type="text" placeholder="Enter job title" name="jobTitle"
                                            class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100">
                                    </div>

                                    <!-- Job Category -->
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            Job Category <span class="text-red-500">*</span>
                                        </label>

                                        <select name="jobCategory"
                                            class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100">

                                            <option>Select category</option>
                                            <option>Web Development</option>
                                            <option>Software Developer</option>
                                            <option>UI/UX Designer</option>

                                        </select>
                                    </div>

                                    <!-- Job Type -->
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            Job Type <span class="text-red-500">*</span>
                                        </label>

                                        <select name="jobType"
                                            class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100">

                                            <option>Select job type</option>
                                            <option>Full Time</option>
                                            <option>Part Time</option>
                                            <option>Internship</option>

                                        </select>
                                    </div>

                                    <!-- Experience -->
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            Experience <span class="text-red-500">*</span>
                                        </label>

                                        <select name="experience"
                                            class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100">

                                            <option>Select experience</option>
                                            <option>Fresher</option>
                                            <option>1-2 Years</option>
                                            <option>3+ Years</option>

                                        </select>
                                    </div>

                                    <!-- Salary -->
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            Salary Range <span class="text-red-500">*</span>
                                        </label>

                                        <select name="salary"
                                            class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100">

                                            <option>Select salary range</option>
                                            <option>3-5 LPA</option>
                                            <option>5-8 LPA</option>
                                            <option>8+ LPA</option>

                                        </select>
                                    </div>

                                    <!-- Location -->
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            Location <span class="text-red-500">*</span>
                                        </label>

                                        <input type="text" placeholder="Enter location" name="companyLocation"
                                            class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100">
                                    </div>

                                </div>

                            </div>


                            <!-- ***********JOB DESCRIPTION********** -->
                            <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 mt-6">

                                <!-- Heading -->
                                <div class="flex items-center gap-3 mb-6">
                                    <div class="w-10 h-10 rounded-lg bg-blue-50 flex items-center justify-center">
                                        <i class="ri-file-text-line text-blue-600 text-xl"></i>
                                    </div>

                                    <h2 class="text-xl font-semibold text-gray-800">
                                        Job Description
                                    </h2>
                                </div>

                                <div class="relative">

                                    <textarea maxlength="1000" rows="7" name="jobDescription"
                                        placeholder="Write a detailed job description..."
                                        class="w-full border border-gray-300 rounded-xl px-4 py-4 resize-none outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100"></textarea>

                                    <!-- Character Count -->
                                    <span class="absolute bottom-4 right-4 text-sm text-gray-400">
                                        0 / 1000
                                    </span>

                                </div>

                            </div>


                            <!-- *********** SKILLS REQUIRED********** -->
                            <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 mt-6">

                                <!-- Heading -->
                                <div class="flex items-center gap-3 mb-6">
                                    <div class="w-10 h-10 rounded-lg bg-blue-50 flex items-center justify-center">
                                        <i class="ri-code-box-line text-blue-600 text-xl"></i>
                                    </div>

                                    <h2 class="text-xl font-semibold text-gray-800">
                                        Skills Required
                                    </h2>
                                </div>

                                <!-- Input -->
                                <input type="text" placeholder="Add skills (e.g. React, Node.js, Python)" name="addSkills"
                                    class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100">

                                <!-- Skills Tags -->
                                <div class="flex flex-wrap gap-3 mt-5">

                                    <span
                                        class="flex items-center gap-2 px-4 py-2 bg-blue-50 text-blue-600 rounded-lg text-sm font-medium">
                                        React
                                        <i class="ri-close-line cursor-pointer"></i>
                                    </span>

                                    <span
                                        class="flex items-center gap-2 px-4 py-2 bg-blue-50 text-blue-600 rounded-lg text-sm font-medium">
                                        JavaScript
                                        <i class="ri-close-line cursor-pointer"></i>
                                    </span>

                                    <span
                                        class="flex items-center gap-2 px-4 py-2 bg-blue-50 text-blue-600 rounded-lg text-sm font-medium">
                                        HTML
                                        <i class="ri-close-line cursor-pointer"></i>
                                    </span>

                                    <span
                                        class="flex items-center gap-2 px-4 py-2 bg-blue-50 text-blue-600 rounded-lg text-sm font-medium">
                                        CSS
                                        <i class="ri-close-line cursor-pointer"></i>
                                    </span>

                                </div>

                            </div>



                            <!-- *********** ADDITIONAL DETAILS********** -->
                            <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 mt-6">

                                <!-- Heading -->
                                <div class="flex items-center gap-3 mb-6">
                                    <div class="w-10 h-10 rounded-lg bg-blue-50 flex items-center justify-center">
                                        <i class="ri-file-list-3-line text-blue-600 text-xl"></i>
                                    </div>

                                    <h2 class="text-xl font-semibold text-gray-800">
                                        Additional Details
                                    </h2>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">

                                    <!-- Vacancies -->
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            Number of Vacancies
                                        </label>

                                        <input type="number" name="vacancies" placeholder="e.g. 5" 
                                            class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-blue-100 focus:border-blue-500">
                                    </div>

                                    <!-- Deadline -->
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            Application Deadline
                                        </label>

                                        <input type="date" name="deadline"
                                            class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-blue-100 focus:border-blue-500">
                                    </div>

                                    <!-- Work Mode -->
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            Work Mode
                                        </label>

                                        <select name="workMode"
                                            class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-blue-100 focus:border-blue-500">

                                            <option>Select Work Mode</option>
                                            <option>Remote</option>
                                            <option>Hybrid</option>
                                            <option>On Site</option>

                                        </select>
                                    </div>

                                    <!-- Education -->
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            Education Required
                                        </label>

                                        <input type="text" name="education" placeholder="e.g. B.Tech"
                                            class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-blue-100 focus:border-blue-500">
                                    </div>

                                    <!-- Gender -->
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            Gender Preference
                                        </label>

                                        <select name="Gender"
                                            class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-blue-100 focus:border-blue-500">

                                            <option>No Preference</option>
                                            <option>Male</option>
                                            <option>Female</option>

                                        </select>
                                    </div>

                                    <!-- Status -->
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            Job Status
                                        </label>

                                        <select name="status"
                                            class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-blue-100 focus:border-blue-500">

                                            <option>Open</option>
                                            <option>Closed</option>
                                            <option>Paused</option>

                                        </select>
                                    </div>

                                </div>

                            </div>

                            <div class="flex justify-end gap-4 mt-8">
                                <button type="button"
                                    class="px-6 py-3 rounded-xl border border-gray-300 hover:bg-gray-100">
                                    Cancel
                                </button>

                                <button type="submit"
                                    class="px-6 py-3 rounded-xl bg-blue-600 text-white hover:bg-blue-700">
                                    Post Job
                                </button>
                            </div>
                        </form>

                    </div>

                </div>

            </div>

        </div>
    </div>
    <script>
        let menubtn = document.querySelector(".menubtn");
        let sidebar = document.querySelector(".sidebar");
        let cross = document.querySelector(".cross");
        let overlay = document.querySelector(".overlay")




        menubtn.addEventListener("click", () => {
            sidebar.classList.remove("-translate-x-full");
            overlay.classList.remove("hidden");
        });

        cross.addEventListener("click", () => {
            sidebar.classList.add("-translate-x-full")
            overlay.classList.add("hidden");

        })

        overlay.addEventListener("click", () => {
            sidebar.classList.add("-translate-x-full");
            overlay.classList.add("hidden");
        })

    </script>
</body>

</html>