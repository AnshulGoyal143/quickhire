<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.6.0/fonts/remixicon.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="overflow-x-hidden">
    <div class="w-full min-h-screen relative bg-gray-50">

        <div class="relative z-10 ">

            <nav class="w-full h-16 bg-gray-100 flex items-center justify-between px-3 py-2 fixed top-0">
                <div class="flex items-center justify-between sm:gap-4 lg:gap-6">
                    <div class="menubtn">
                        <i class="ri-menu-fill text-2xl"></i>
                    </div>
                    <h2 class="text-lg md:text-xl font-semibold text-gray-800 ml-2">Dashboard</h2>
                </div>
                <div class="flex items-center gap-6">
                    <!-- notification k ley route bnana h -->
                    <a href=""><i class="ri-notification-3-line text-2xl"></i>
                    </a>
                    <div class="flex items-center gap-2">

                        <% if (user.profileImage && user.profileImage.data) { %>

                            <img src="data:<%= user.profileImage.contentType %>;base64,<%= user.profileImage.data.toString('base64') %>"
                                alt="Profile" class="h-10 w-10 rounded-full object-cover">

                            <% } else { %>

                                <div
                                    class="h-10 w-10 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-semibold">
                                    <%= user.fullname ? user.fullname.charAt(0).toUpperCase() : "U" %>
                                </div>

                                <% } %>

                                    <h2 class="text-xl font-semibold hidden md:block">
                                        <%= user.fullname %>
                                    </h2>

                                    <a href="">
                                        <i class="ri-arrow-down-wide-line"></i>
                                    </a>

                    </div>
                </div>
            </nav>
            <!-- *********** FOr the menu list div ********-->
            <div
                class=" sidebar fixed top-0 left-0 w-72 h-screen bg-white shadow-2xl z-50 -translate-x-full transition-transform duration-300 p-4">

                <div class="flex items-center ">
                    <img class="h-8"
                        src="https://static.vecteezy.com/system/resources/thumbnails/070/916/787/small/a-3d-render-of-a-light-blue-briefcase-with-the-word-job-in-white-letters-isolated-on-transparent-background-png.png"
                        alt="">
                    <h5 class="text-xl font-bold">Quick <span class="text-blue-500">Hire</span></h5>
                </div>
                <div class="cross flex justify-end ">
                    <i
                        class="ri-close-line text-2xl w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center cursor-pointer hover:bg-gray-200"></i>
                </div>
                <div class="list">
                    <ul class=" space-y-3">
                        <!-- yha pee user dashboard menu link attach krne h -->

                        <li
                            class="flex items-center gap-2 px-4 py-3 rounded-xl cursor-pointer hover:bg-gray-100 mb-1 mt-1">
                            <a href="/users/userDashboard">
                                <i class="ri-home-3-line text-xl"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>


                        <li
                            class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer  bg-blue-100 text-blue-600  ">
                            <a href="">
                                <i class="ri-file-list-3-line text-xl"></i>
                                <span>My Applications</span>
                            </a>
                        </li>

                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100 ">
                            <a href="">
                                <i class="ri-briefcase-line text-xl"></i>
                                <span>Browse Jobs</span>
                            </a>
                        </li>

                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">
                            <a href="/users/userProfile">
                                <i class="ri-user-3-line text-xl"></i>
                                <span>My Profile</span>
                            </a>
                        </li>

                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">
                            <a href="/users/ProfileEdit">
                                <i class="ri-edit-2-line text-xl"></i>
                                <span>Edit Profile</span>
                            </a>
                        </li>

                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer mt-8 hover:bg-gray-100">
                            <a href="/logout">
                                <i class="ri-logout-box-r-line text-xl"></i>
                                <span>Logout</span>
                            </a>
                        </li>


                    </ul>
                </div>
            </div>

            <div class="overlay fixed inset-0 bg-black/30 hidden z-40"></div>



            <div class="textcontainer px-6 sm:px-8 lg:px-12 py-2 pt-28 pb-10 transition-all duration-300">

                <!-- ================= PAGE HEADER ================= -->

                <div class="welcome mb-8">

                    <h4 class="text-3xl sm:text-4xl font-bold text-gray-900">
                        My Applications
                    </h4>

                    <p class="text-base sm:text-lg mt-2 text-gray-600">
                        Track and manage all your job applications in one place.
                    </p>

                </div>


                <!-- ================= FILTER + SEARCH ================= -->

                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-7">

                    <!-- Status Tabs -->
                    <div class="flex items-center overflow-x-auto border border-gray-200 rounded-xl">

                        <!-- All -->
                        <button
                            class="flex items-center gap-2 px-5 py-3 bg-blue-50  text-blue-600 border border-blue-400 font-semibold text-sm whitespace-nowrap">

                            <span>All Applications</span>

                            <span class="bg-blue-100 text-blue-600 px-2 py-0  rounded-full text-xs">
                                10
                            </span>

                        </button>


                        <!-- In Review -->
                        <button class="flex items-center gap-2 px-5 py-3
                       text-gray-600 hover:bg-gray-50 font-medium text-sm whitespace-nowrap border-l border-gray-200">

                            <span>In Review</span>

                            <span class="bg-orange-100 text-orange-600 px-2 py-0.5 rounded-full text-xs">
                                3
                            </span>

                        </button>


                        <!-- Shortlisted -->
                        <button
                            class="flex items-center gap-2 px-5 py-3 text-gray-600 hover:bg-gray-50 font-medium text-sm whitespace-nowrap border-l border-gray-200">

                            <span>Shortlisted</span>

                            <span class="bg-green-100 text-green-600 px-2 py-0.5 rounded-full text-xs">
                                2
                            </span>

                        </button>


                        <!-- Rejected -->
                        <button
                            class="flex items-center gap-2 px-5 py-3 text-gray-600 hover:bg-gray-50 font-medium text-sm whitespace-nowrap border-l border-gray-200">

                            <span>Rejected</span>

                            <span class="bg-red-100 text-red-600 px-2 py-0.5 rounded-full text-xs">
                                2
                            </span>

                        </button>

                    </div>


                    <!-- Search + Filter -->

                    <div class="flex items-center gap-3">

                        <!-- Search -->
                        <div class="relative w-full sm:w-[300px]">

                            <i class="ri-search-line absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-lg">
                            </i>

                            <input type="text" placeholder="Search applications..."
                                class="w-full border border-gray-200 rounded-xl py-3 pl-11 pr-4 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 text-sm">
                        </div>

                    </div>

                </div>


                <!-- ================= APPLICATION TABLE ================= -->

                <div class="bg-white rounded-2xl border border-gray-200
               shadow-sm overflow-hidden">

                    <div class="overflow-x-auto">

                        <table class="w-full min-w-[950px]">

                            <!-- TABLE HEADER -->

                            <thead class="bg-gray-50 border-b border-gray-200">

                                <tr>

                                    <th class="text-left px-6 py-5 text-sm font-semibold text-gray-600">
                                        Job Details
                                    </th>

                                    <th class="text-left px-6 py-5 text-sm font-semibold text-gray-600">
                                        Applied On
                                    </th>

                                    <th class="text-left px-6 py-5 text-sm font-semibold text-gray-600">
                                        Status
                                    </th>

                                    <th class="text-left px-6 py-5 text-sm font-semibold text-gray-600">
                                        Action
                                    </th>

                                </tr>

                            </thead>


                            <!-- TABLE BODY -->
                            <tbody>

                                <% if (applications && applications.length> 0) { %>

                                    <% applications.forEach(application=> { %>

                                        <tr class="border-b border-gray-200 hover:bg-gray-50 transition">

                                            <!-- JOB DETAILS -->
                                            <td class="px-6 py-5">

                                                <div class="flex items-center gap-4">

                                                    <!-- Company Logo -->
                                                    <div
                                                        class="w-14 h-14 rounded-full border border-gray-200 flex items-center justify-center bg-gray-50 overflow-hidden shrink-0">

                                                        <% if ( application.company &&
                                                            application.company.companyProfile &&
                                                            application.company.companyProfile.data ) { %>

                                                            <img src="data:<%= application.company.companyProfile.contentType %>;base64,<%= application.company.companyProfile.data.toString('base64') %>"
                                                                alt="Company Logo" class="w-full h-full object-cover">

                                                            <% } else { %>

                                                                <i class="ri-building-line text-2xl text-gray-400"></i>

                                                                <% } %>

                                                    </div>


                                                    <!-- Job Info -->
                                                    <div>

                                                        <h3 class="font-semibold text-gray-900 text-base">

                                                            <%= application.job.jobTitle %>

                                                        </h3>


                                                        <div class="flex items-center gap-2 mt-1 text-sm text-gray-500">

                                                            <span>
                                                                <%= application.company.companyName %>
                                                            </span>

                                                            <span>•</span>

                                                            <i class="ri-map-pin-line"></i>

                                                            <span>
                                                                <%= application.job.companyLocation %>
                                                            </span>

                                                        </div>

                                                    </div>

                                                </div>

                                            </td>


                                            <!-- APPLIED ON -->
                                            <td class="px-6 py-5 text-sm text-gray-600">

                                                <%= new Date(application.appliedAt).toLocaleDateString("en-IN", {
                                                    day: "2-digit" , month: "short" , year: "numeric" }) %>

                                            </td>


                                            <!-- STATUS -->
                                            <td class="px-6 py-5">

                                                <% if (application.status==="Shortlisted" ) { %>

                                                    <span class="inline-flex items-center px-3 py-1.5
                                     rounded-lg bg-green-100 text-green-600
                                     text-xs font-semibold">

                                                        Shortlisted

                                                    </span>

                                                    <% } else if (application.status==="Rejected" ) { %>

                                                        <span class="inline-flex items-center px-3 py-1.5
                                     rounded-lg bg-red-100 text-red-600
                                     text-xs font-semibold">

                                                            Rejected

                                                        </span>

                                                        <% } else { %>

                                                            <span class="inline-flex items-center px-3 py-1.5
                                     rounded-lg bg-orange-100 text-orange-600
                                     text-xs font-semibold">

                                                                In Review

                                                            </span>

                                                            <% } %>

                                            </td>


                                            <!-- ACTION -->
                                            <td class="px-6 py-5">

                                                <div class="flex items-center gap-3">

                                                    <a href="/users/application/<%= application._id %>" class="px-4 py-2 rounded-lg
                                   border border-gray-200
                                   text-blue-600 text-sm font-medium
                                   hover:bg-blue-50 transition">

                                                        View Details

                                                    </a>

                                                    <button class="text-gray-500 hover:text-gray-800">

                                                        <i class="ri-more-2-fill text-xl"></i>

                                                    </button>

                                                </div>

                                            </td>

                                        </tr>

                                        <% }) %>


                                            <% } else { %>

                                                <!-- NO APPLICATIONS -->
                                                <tr>

                                                    <td colspan="4" class="px-6 py-16 text-center">

                                                        <div class="flex flex-col items-center">

                                                            <i class="ri-file-list-3-line text-5xl text-gray-300"></i>

                                                            <h3 class="mt-4 text-lg font-semibold text-gray-700">
                                                                No Applications Yet
                                                            </h3>

                                                            <p class="mt-1 text-sm text-gray-500">
                                                                You haven't applied for any jobs yet.
                                                            </p>

                                                        </div>

                                                    </td>

                                                </tr>

                                                <% } %>

                            </tbody>

                        </table>

                    </div>




                    <!-- ================= PAGINATION ================= -->

                    <% if (totalPages> 1) { %>

                        <div
                            class="flex flex-col sm:flex-row items-center justify-between gap-4 px-6 py-4 border-t border-gray-200">

                            <!-- LEFT SIDE -->
                            <div class="text-sm text-gray-500">
                                Page <span class="font-semibold text-gray-700">
                                    <%= currentPage %>
                                </span>
                                of
                                <span class="font-semibold text-gray-700">
                                    <%= totalPages %>
                                </span>
                            </div>


                            <!-- PAGINATION -->
                            <div class="flex items-center gap-2">

                                <!-- PREVIOUS -->
                                <% if (currentPage> 1) { %>

                                    <a href="/users/userMyApplications?page=<%= currentPage - 1 %>" class="flex items-center gap-2 px-4 py-2.5 rounded-lg
                      border border-gray-200
                      text-gray-700
                      hover:bg-gray-50 transition">

                                        <i class="ri-arrow-left-line"></i>
                                        Previous

                                    </a>

                                    <% } else { %>

                                        <span class="flex items-center gap-2 px-4 py-2.5 rounded-lg
                       border border-gray-200
                       text-gray-400
                       cursor-not-allowed">

                                            <i class="ri-arrow-left-line"></i>
                                            Previous

                                        </span>

                                        <% } %>


                                            <!-- PAGE NUMBERS -->

                                            <div class="flex items-center gap-2">

                                                <% for(let i=1; i <=totalPages; i++) { %>

                                                    <% if(i===currentPage) { %>

                                                        <a href="/users/userMyApplications?page=<%= i %>" class="w-10 h-10 rounded-lg
                              bg-blue-50
                              text-blue-600
                              border border-blue-200
                              font-semibold
                              flex items-center justify-center">

                                                            <%= i %>

                                                        </a>

                                                        <% } else { %>

                                                            <a href="/users/userMyApplications?page=<%= i %>" class="w-10 h-10 rounded-lg
                              border border-gray-200
                              text-gray-600
                              hover:bg-gray-50
                              flex items-center justify-center
                              transition">

                                                                <%= i %>

                                                            </a>

                                                            <% } %>

                                                                <% } %>

                                            </div>


                                            <!-- NEXT -->
                                            <% if (currentPage < totalPages) { %>

                                                <a href="/users/userMyApplications?page=<%= currentPage + 1 %>" class="flex items-center gap-2 px-4 py-2.5 rounded-lg
                      border border-gray-200
                      text-gray-700
                      hover:bg-gray-50 transition">

                                                    Next
                                                    <i class="ri-arrow-right-line"></i>

                                                </a>

                                                <% } else { %>

                                                    <span class="flex items-center gap-2 px-4 py-2.5 rounded-lg
                       border border-gray-200
                       text-gray-400
                       cursor-not-allowed">

                                                        Next
                                                        <i class="ri-arrow-right-line"></i>

                                                    </span>

                                                    <% } %>

                            </div>

                        </div>

                        <% } %>

                </div>




            </div>




        </div>

    </div>
    <script>
        let menubtn = document.querySelector(".menubtn");
        let sidebar = document.querySelector(".sidebar");
        let cross = document.querySelector(".cross");
        let overlay = document.querySelector(".overlay")

        menubtn.addEventListener("click", () => {
            sidebar.classList.remove("-translate-x-full");
            overlay.classList.remove("hidden");
        });

        cross.addEventListener("click", () => {
            sidebar.classList.add("-translate-x-full")
            overlay.classList.add("hidden");

        })

        overlay.addEventListener("click", () => {
            sidebar.classList.add("-translate-x-full");
            overlay.classList.add("hidden");
        })

    </script>
</body>

</html>