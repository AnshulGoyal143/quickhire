<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.6.0/fonts/remixicon.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class="w-full min-h-full ">
        <!-- ******NAVBAR ************* -->
        <nav class="w-full  h-16 bg-gray-100 flex items-center justify-between px-2 py-1">
            <div class="flex items-center ">
                <img class="h-10"
                    src="https://static.vecteezy.com/system/resources/thumbnails/070/916/787/small/a-3d-render-of-a-light-blue-briefcase-with-the-word-job-in-white-letters-isolated-on-transparent-background-png.png"
                    alt="">
                <h5 class="text-2xl font-semibold">Quick <span class="text-blue-500">Hire</span></h5>
            </div>
            <div class=" items-centre justify-center gap-8 hidden md:flex ">
               <div class="flex items-center gap-2">
                 <img class="h-7" src="https://cdn-icons-png.flaticon.com/512/6522/6522516.png" alt="">
                <a class="text-sm sm:text-base lg:text-xl" href="">About Us</a>
               </div>

                <div class="flex items-center gap-2">
                    <img class="h-7" src="https://i.pinimg.com/736x/fc/27/fb/fc27fb81e77cc56ba4ed981d7801ceb9.jpg" alt="">
                <a class="text-sm sm:text-base lg:text-xl" href="">Contact</a>
                </div>
            </div>


        </nav>
        <!-- *******************main box************ -->
        <div class="w-full min-h-screen  relative overflow-hidden ">
            <div class=" bg-cover bg-center bg-no-repeat absolute inset-0 opacity-50 "
                style="background-image: url('/images/WhatsApp\ Image\ 2026-07-09\ at\ 3.40.54\ PM.jpeg') ;">
            </div>

            <div class="relative z-10 flex flex-col items-center py-12 justify-center">
                <!-- *************text area************* -->
                <div class="text-center p-4">
                    <h1 class="text-4xl font-semibold">Hire Smart. Hire Fast.</h1>
                    <h1 class="text-4xl font-semibold">Welcome to <span class="text-blue-600">QuickHire</span></h1>
                    <p class="text-2xl text-gray-700 mt-4"> A trusted platform that connects talent with opportunities.
                    </p>
                    <p class="text-2xl text-blue-600 font-medium mt-6">Choose your login type to get started</p>
                </div>
                <!-- **********LOGIN OPTION********** -->
                <div class="flex flex-col md:flex-col lg:flex-row justify-center items-center gap-8 px-4 mt-8 w-full">
                    <div
                        class="box w-full max-w-[350px] min-h-[340px] bg-white rounded-3xl shadow-xl flex flex-col p-6 items-center">
                        <div class="circle w-24 h-24 bg-blue-100 flex items-center rounded-full justify-center mt-2">
                            <img class="h-15" src="https://static.thenounproject.com/png/administrator-icon-1059178-512.png" alt="">
                        </div>
                        <div class="text text-center mt-2 ">
                            <h2 class="text-2xl font-semibold">Admin Login</h2>
                            <h5 class="text-gray-600 text-xl mt-2">Secure access for administrators <br>to manage the
                                platform.</h5>

                        </div>
                        <div class="button w-full mt-auto pt-6 ">
                     
                            <a href="/admin/login"    class="h-12 w-full bg-blue-600 rounded-xl text-white text-xl flex items-center justify-center gap-2 cursor-pointer">
                                       
                             Login as Admin <i class="ri-arrow-right-line"></i>
                            </a>

                        </div>

                    </div>

                    <!-- ****************************** -->

                    <div
                        class="box w-full max-w-[350px] min-h-[340px] bg-white rounded-3xl shadow-xl flex flex-col p-6 items-center">
                        <div class="circle w-24 h-24 bg-green-300 flex items-center rounded-full justify-center mt-2">
                            <img class="h-13" src="https://static.vecteezy.com/system/resources/thumbnails/053/964/117/small/a-silhouette-of-a-person-with-a-circular-head-and-a-minimalistic-body-structure-showcasing-a-simple-design-png.png" alt="">
                        </div>
                        <div class="text text-center mt-2 ">
                            <h2 class="text-2xl font-semibold">User Login</h2>
                            <h5 class="text-gray-600 text-xl mt-2">Access your account to find <br>and apply for jobs.
                        </h5>

                        </div>
                        <div class="button w-full mt-auto pt-6 ">
                         <a href="/users/login"  class="h-12 w-full bg-green-400 rounded-xl text-white text-xl flex items-center justify-center gap-2 cursor-pointer">
                               Login as User <i class="ri-arrow-right-line"></i>
                         </a>

                        </div>
                    </div>

                    <!-- ****************************** -->

                    <div
                        class="box w-full max-w-[350px] min-h-[340px] bg-white rounded-3xl shadow-xl flex flex-col p-6 items-center">
                        <div class="circle w-24 h-24 bg-purple-300 flex items-center rounded-full justify-center mt-2">
                            <img class="h-13 " src="https://cdn-icons-png.flaticon.com/512/6361/6361489.png" alt="">
                        </div>
                        <div class="text text-center mt-2 ">
                            <h2 class="text-2xl font-semibold">Company Login</h2>
                            <h5 class="text-gray-600 text-xl mt-2">Access your company account to post jobs and hire talent.
                        </h5>

                        </div>
                        <div class="button w-full mt-auto pt-6 ">
                          <a href="/company/login" class="h-12 w-full bg-purple-600 rounded-xl text-white text-xl flex items-center justify-center gap-2 cursor-pointer">
                              Login as Company <i class="ri-arrow-right-line"></i>
                          </a>

                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</body>

</html>