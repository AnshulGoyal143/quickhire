<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin - Edit Profile</title>

    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.6.0/fonts/remixicon.css" rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="overflow-x-hidden ">

    <div class="w-full min-h-screen relative bg-gray-50">

        <div class="relative">
            <!-- ================= NAVBAR ================= -->

            <nav class="w-full h-16 bg-gray-100 flex items-center justify-between px-3 py-2 fixed top-0 z-30">
                <div class="flex items-center justify-between sm:gap-4 lg:gap-6">
                    <div class="menubtn">
                        <i class="ri-menu-fill text-2xl"></i>
                    </div>
                    <h2 class="text-lg md:text-xl font-semibold text-gray-800 ml-2">Dashboard</h2>
                </div>
                <div class="flex items-center gap-6">
                    <!-- notification k ley route bnana h -->
                    <a href=""><i class="ri-notification-3-line text-2xl"></i>
                    </a>
                    <div class="flex items-center gap-2">

                        <div
                            class="h-11 w-11 rounded-full overflow-hidden bg-blue-100 flex items-center justify-center">

                            <% if (admin?.profileImage &&
                                admin.profileImage !== "default-admin.png") { %>

                                <img src="/admin/admin-profile"
                                    alt="Admin Profile"
                                    class="w-full h-full object-cover">

                                <% } else { %>

                                    <i class="ri-admin-fill text-2xl text-blue-500"></i>

                                    <% } %>

                        </div>

                        <h2 class="text-xl font-semibold hidden md:block text-gray-800">
                            Admin
                        </h2>

                        <a href="">
                            <i class="ri-arrow-down-wide-line text-gray-600"></i>
                        </a>

                    </div>
                </div>
            </nav>
            <!-- *********** FOr the menu list div ********-->
            <div
                class=" sidebar fixed top-0 left-0 w-72 h-screen bg-white shadow-2xl z-[60] -translate-x-full transition-transform duration-300 p-4">

                <div class="flex items-center ">
                    <img class="h-8"
                        src="https://static.vecteezy.com/system/resources/thumbnails/070/916/787/small/a-3d-render-of-a-light-blue-briefcase-with-the-word-job-in-white-letters-isolated-on-transparent-background-png.png"
                        alt="">
                    <h5 class="text-xl font-bold">Quick <span class="text-blue-500">Hire</span></h5>
                </div>

                <div class="cross flex justify-end mb-3">
                    <i
                        class="ri-close-line text-2xl w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center cursor-pointer hover:bg-gray-200"></i>
                </div>
                <div class="list">
                    <ul class=" space-y-3">
                        <!-- yha pee user dashboard menu link attach krne h -->

                        <li
                            class="flex items-center gap-2 px-4 py-3 rounded-xl cursor-pointer hover:bg-gray-100  mb-1">
                            <a href="/admin/adminDashboard">
                                <i class="ri-home-3-line text-xl"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>


                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100 ">
                            <a href="/admin/adminUserDashboard">
                                <i class="ri-group-line text-xl"></i>
                                <span>Users</span>
                            </a>
                        </li>


                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">
                            <a href="/admin/adminCompanyDashboard">
                                <i class="ri-building-2-line text-xl"></i>
                                <span>Companies</span>
                            </a>
                        </li>


                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">
                            <a href="/admin/adminJobDashboard">
                                <i class="ri-briefcase-4-line text-xl"></i>
                                <span>Jobs</span>
                            </a>
                        </li>


                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">
                            <a href="/admin/adminApplications">
                                <i class="ri-file-list-3-line text-xl"></i>
                                <span>Applications</span>
                            </a>
                        </li>

                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer bg-blue-100 text-blue-600 ">
                            <a href="/admin/adminProfilePage">
                                <i class="ri-group-line text-xl"></i>
                                <span>My Profile</span>
                            </a>
                        </li>

                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer mt-8 hover:bg-gray-100">
                            <a href="/admin/logout">
                                <i class="ri-logout-box-r-line text-xl"></i>
                                <span>Logout</span>
                            </a>
                        </li>


                    </ul>
                </div>
            </div>


            <!-- Overlay -->

            <div class="overlay fixed inset-0 bg-black/30 hidden z-40"></div>


            <!-- ================= MAIN CONTENT ================= -->

            <main class="relative z-0 pt-24 pb-12 px-6 md:px-8 lg:px-10">


                <div class="w-full max-w-none mx-auto">

                    <!-- Heading -->

                    <div class="mb-7">

                        <h1 class="text-3xl md:text-4xl font-bold text-gray-800">
                            Edit Profile
                        </h1>

                        <p class="text-gray-500 mt-2">
                            Update your administrator account information
                        </p>

                    </div>

                    <!-- ================= CARD ================= -->

                    <div class="bg-white rounded-3xl shadow-lg border border-gray-100 overflow-hidden">


                        <!-- Card Header -->

                        <div class="px-6 md:px-8 py-6 border-b border-gray-200 ">

                            <div class="flex items-center gap-3">

                                <div class="w-11 h-11 rounded-xl bg-blue-50 flex items-center justify-center">

                                    <i class="ri-admin-line text-xl text-blue-600"></i>

                                </div>

                                <div>

                                    <h2 class="text-lg font-semibold text-gray-800">
                                        Personal Information
                                    </h2>

                                    <p class="text-sm text-gray-500">
                                        Keep your admin profile up to date
                                    </p>

                                </div>

                            </div>

                        </div>


                        <!-- Form -->

                        <form action="/admin/adminProfileEdit" method="POST" enctype="multipart/form-data"
                            class="p-6 md:p-8">

                            <!-- ================= PROFILE IMAGE ================= -->

                            <div class="mb-8">

                                <label class="text-lg font-semibold text-gray-700">
                                    Profile Picture
                                </label>

                                <div
                                    class="mt-4 flex flex-col sm:flex-row items-center sm:items-start gap-6 p-5 rounded-2xl bg-gray-50 border border-gray-200">


                                    <!-- Preview -->

                                    <div
                                        class="relative w-28 h-28 rounded-2xl overflow-hidden border-2 border-white shadow-md bg-blue-100 flex-shrink-0">

                                        <% if (admin?.profileImage?.data) { %>

                                            <img id="profilePreview" src="/admin/admin-profile" alt="Admin Profile"
                                                class="w-full h-full object-cover">

                                            <% } else { %>

                                                <div id="defaultIcon"
                                                    class="w-full h-full flex items-center justify-center">
                                                    <i class="ri-admin-fill text-5xl text-blue-400"></i>
                                                </div>

                                                <img id="profilePreview" src=""
                                                    class="hidden w-full h-full object-cover">

                                                <% } %>
                                    </div>


                                    <!-- Upload Details -->

                                    <div class="flex-1 text-center sm:text-left">

                                        <h3 class="font-semibold text-gray-800">
                                            Admin Profile Photo
                                        </h3>

                                        <p class="text-sm text-gray-500 mt-1">
                                            Upload a professional profile picture
                                        </p>


                                        <input type="file" id="profileInput" name="profileImage"
                                            accept="image/png,image/jpeg,image/jpg" class="hidden">


                                        <button type="button" onclick="document.getElementById('profileInput').click()"
                                            class="mt-4 px-5 py-2.5 rounded-xl bg-blue-600 text-white text-sm font-medium hover:bg-blue-700 transition inline-flex items-center gap-2">

                                            <i class="ri-upload-cloud-2-line text-lg"></i>

                                            <span id="uploadText">
                                                Change Photo
                                            </span>

                                        </button>


                                        <p class="text-xs text-gray-400 mt-2">
                                            PNG or JPG • Maximum 2 MB
                                        </p>

                                    </div>

                                </div>

                            </div>


                            <!-- Divider -->

                            <div class="border-t border-gray-100 mb-8"></div>


                            <!-- ================= INPUTS ================= -->

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">


                                <!-- Full Name -->

                                <div>

                                    <label class="block text-sm font-semibold text-gray-700 mb-2">

                                        Full Name

                                    </label>

                                    <div class="relative">

                                        <i
                                            class="ri-user-line absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-lg">
                                        </i>

                                        <input type="text" name="fullName" value="<%= admin?.fullName || '' %>"
                                            placeholder="Enter your full name" required
                                            class="w-full border border-gray-200 rounded-xl pl-11 pr-4 py-3.5 outline-none
                                        focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition text-gray-800">

                                    </div>

                                </div>


                                <!-- Email -->

                                <div>

                                    <label class="block text-sm font-semibold text-gray-700 mb-2">

                                        Admin Email

                                    </label>

                                    <div class="relative">

                                        <i
                                            class="ri-mail-line absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-lg">
                                        </i>

                                        <input type="email" name="adminEmail" value="<%= admin?.adminEmail || '' %>"
                                            placeholder="Enter admin email" required
                                            class="w-full border border-gray-200 rounded-xl pl-11 pr-4 py-3.5 outline-none
                                        focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition text-gray-800">

                                    </div>

                                </div>

                            </div>


                            <!-- ================= ACCOUNT INFO ================= -->

                            <div class="mt-8 p-4 rounded-xl bg-gray-50 border border-gray-100 flex items-start gap-3">

                                <i class="ri-information-line text-blue-500 text-xl mt-0.5">
                                </i>

                                <div>

                                    <p class="text-sm font-medium text-gray-700">
                                        Account Information
                                    </p>

                                    <p class="text-xs text-gray-500 mt-1">
                                        Your administrator role and account status are managed by the system.
                                    </p>

                                </div>

                            </div>


                            <!-- ================= BUTTONS ================= -->

                            <div
                                class="flex flex-col-reverse sm:flex-row justify-end gap-3 mt-8 pt-6 border-t border-gray-100">


                                <button type="button" onclick="history.back()" class="px-6 py-3 rounded-xl border border-gray-200 text-gray-700 font-medium
                                hover:bg-gray-50 transition">

                                    Cancel

                                </button>


                                <button type="submit" class="px-7 py-3 rounded-xl bg-blue-600 text-white font-medium
                                hover:bg-blue-700 shadow-sm hover:shadow-md transition
                                flex items-center justify-center gap-2">

                                    <i class="ri-save-3-line"></i>

                                    Save Changes

                                </button>

                            </div>


                        </form>

                    </div>

                </div>

            </main>
        </div>

    </div>


    <!-- ================= JAVASCRIPT ================= -->

    <script>

        // Sidebar

        const menuBtn = document.querySelector(".menubtn");
        const sidebar = document.querySelector(".sidebar");
        const cross = document.querySelector(".cross");
        const overlay = document.querySelector(".overlay");


        menuBtn.addEventListener("click", () => {

            sidebar.classList.remove("-translate-x-full");
            overlay.classList.remove("hidden");

        });


        cross.addEventListener("click", () => {

            sidebar.classList.add("-translate-x-full");
            overlay.classList.add("hidden");

        });


        overlay.addEventListener("click", () => {

            sidebar.classList.add("-translate-x-full");
            overlay.classList.add("hidden");

        });



        // Profile Image Preview

        const profileInput = document.getElementById("profileInput");
        const profilePreview = document.getElementById("profilePreview");
        const defaultIcon = document.getElementById("defaultIcon");
        const uploadText = document.getElementById("uploadText");


        profileInput.addEventListener("change", function () {

            const file = this.files[0];

            if (!file) return;


            // File type check

            if (!["image/jpeg", "image/jpg", "image/png"].includes(file.type)) {

                alert("Please select a JPG or PNG image.");

                this.value = "";

                return;

            }


            // File size check - 2MB

            if (file.size > 2 * 1024 * 1024) {

                alert("Image size must be less than 2 MB.");

                this.value = "";

                return;

            }


            // Preview

            profilePreview.src = URL.createObjectURL(file);

            profilePreview.classList.remove("hidden");


            if (defaultIcon) {

                defaultIcon.classList.add("hidden");

            }


            uploadText.textContent = "Change Photo";

        });

    </script>

</body>

</html>