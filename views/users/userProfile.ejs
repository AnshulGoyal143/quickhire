<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.6.0/fonts/remixicon.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="overflow-x-hidden">
    <div class="w-full min-h-screen relative bg-gray-50">


        <div class="relative  z-10 pb-20 pt-20">


            <nav class="w-full h-16 bg-gray-100 flex items-center justify-between px-3 py-2 fixed top-0 z-30">
                <div class="flex items-center justify-between sm:gap-4 lg:gap-6">
                    <div class="menubtn">
                        <i class="ri-menu-fill text-2xl"></i>
                    </div>
                    <h2 class="text-lg md:text-xl font-semibold text-gray-800 ml-2">Dashboard</h2>
                </div>
                <div class="flex items-center gap-6">
                    <!-- notification k ley route bnana h -->
                    <a href=""><i class="ri-notification-3-line text-2xl"></i>
                    </a>
                    <div class="flex items-center gap-2">
                        <img class="h-10 w-11 rounded-full"
                            src="https://static.vecteezy.com/system/resources/thumbnails/053/964/117/small/a-silhouette-of-a-person-with-a-circular-head-and-a-minimalistic-body-structure-showcasing-a-simple-design-png.png"
                            alt="">
                        <h2 class="text-xl font-semibold hidden md:block ">
                            <%= user.fullname %>
                        </h2>
                        <a href=""><i class="ri-arrow-down-wide-line"></i></a>
                    </div>
                </div>
            </nav>
            <!-- *********** FOr the menu list div ********-->
            <div
                class=" sidebar fixed top-0 left-0 w-72 h-screen bg-white shadow-2xl z-50 -translate-x-full transition-transform duration-300 p-4">

                <div class="flex items-center ">
                    <img class="h-8"
                        src="https://static.vecteezy.com/system/resources/thumbnails/070/916/787/small/a-3d-render-of-a-light-blue-briefcase-with-the-word-job-in-white-letters-isolated-on-transparent-background-png.png"
                        alt="">
                    <h5 class="text-xl font-bold">Quick <span class="text-blue-500">Hire</span></h5>
                </div>
                <div class="cross flex justify-end ">
                    <i
                        class="ri-close-line text-2xl w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center cursor-pointer hover:bg-gray-200"></i>
                </div>
                <div class="list">
                    <ul class=" space-y-3">
                        <!-- yha pee user dashboard menu link attach krne h -->

                        <li
                            class="flex items-center gap-2 px-4 py-3 rounded-xl cursor-pointer hover:bg-gray-100  mb-1 mt-1">
                            <a href="/users/userDashboard">
                                <i class="ri-home-3-line text-xl"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>


                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100 ">
                            <a href="">
                                <i class="ri-file-list-3-line text-xl"></i>
                                <span>My Applications</span>
                            </a>
                        </li>

                        <li
                            class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer bg-blue-100 text-blue-600 ">
                            <a href="/users/userProfile">
                                <i class="ri-user-3-line text-xl"></i>
                                <span>My Profile</span>
                            </a>
                        </li>

                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">
                            <a href="/users/ProfileEdit">
                                <i class="ri-edit-2-line text-xl"></i>
                                <span>Edit Profile</span>
                            </a>
                        </li>

                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer mt-8 hover:bg-gray-100">
                            <a href="">
                                <i class="ri-logout-box-r-line text-xl"></i>
                                <span>Logout</span>
                            </a>
                        </li>


                    </ul>
                </div>
            </div>

            <div class="overlay fixed inset-0 bg-black/30 hidden z-40"></div>

            <!-- ***************text over picture************* -->
            <div class="  px-6 sm:px-8 lg:px-12  pb-10  transition-all duration-300">

                <h2 class="md:text-4xl text-3xl  font-bold ">My Profile</h2>
                <p class="text-gray-700 mt-2 text-xl mb-5">View and Manage your profile information</p>


                <div
                    class="card bg-white rounded-3xl shadow-xl hover:shadow-2xl  p-8 md:p-8 transition-all duration-300 mt-10 flex flex-col md:flex-row  items-center gap-6">
                    <div
                        class="h-36 w-36 rounded-2xl bg-blue-100 border-4 border-white shadow-md overflow-hidden flex items-center justify-center">
                        <img src="/users/profile-image" alt="Profile Image" class="w-full h-full object-cover"
                            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">

                        <i class="ri-user-3-line text-4xl text-blue-500 hidden"></i>
                    </div>

                    <div class="text md:text-left flex-1">
                        <h2 class="text-2xl font-bold text-gray-800">
                            <%=user.fullname %>
                        </h2>
                        <p class="text-blue-600 font-medium mt-1">Job Seeker</p>
                        <p class="flex items-center  mt-2 gap-2 text-gray-700">
                            <i class="ri-mail-line"></i>
                            <span>
                                <%= user.email %>
                            </span>
                        </p>
                        <p class="flex items-center gap-2 mt-1 text-gray-700">
                            <i class="ri-map-pin-line "></i>
                            <span>
                                <%= user.address %>
                            </span>
                        </p>
                        <div class="flex items-center justify-center md:justify-end mt-2  ">
                            <a href="/users/ProfileEdit"
                                class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 w-full md:w-auto inline-flex items-center gap-2">
                                <i class="ri-edit-line"></i>
                                Edit Profile
                            </a>
                        </div>
                    </div>

                </div>
            </div>

            <!-- *******************PERSONAL INFO AND ACCOUNT INFOOOO -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-6 px-6 sm:px-8 lg:px-12">
                <div class="bg-white rounded-3xl shadow-lg border border-gray-200 p-7">

                    <!-- Heading -->
                    <div class="flex items-center gap-3 mb-8">
                        <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center">
                            <i class="ri-user-3-line text-blue-600 text-xl"></i>
                        </div>

                        <h2 class="text-2xl font-semibold">
                            Personal Information
                        </h2>
                    </div>

                    <!-- Details -->
                    <div class="grid grid-cols-1 md:grid-cols-2">

                        <!-- Full Name -->
                        <div class="border-b border-gray-200 py-5">
                            <p class="text-sm text-gray-500 mb-1">Full Name</p>
                            <h4 class="font-semibold text-gray-800">
                                <%= user.fullname %>
                            </h4>
                        </div>

                        <!-- Username -->
                        <div class="border-b border-gray-200 py-5 md:pl-10">
                            <p class="text-sm text-gray-500 mb-1">Username</p>
                            <h4 class="font-semibold text-gray-800">
                                <%= user.username %>
                            </h4>
                        </div>

                        <!-- dob -->
                        <div class="border-b border-gray-200 py-5">
                            <p class="text-sm text-gray-500 mb-1">Date of Birth</p>
                            <h4 class="font-semibold text-gray-800">
                               <%= user.dob.toISOString().split('T')[0] %>
                            </h4>
                        </div>

                        <!---gender -->
                        <div class="border-b border-gray-200 py-5">
                            <p class="text-sm text-gray-500 mb-1">Gender</p>
                            <h4 class="font-semibold text-gray-800">
                                <%= user.gender %>
                            </h4>
                        </div>

                        <!-- Email -->
                        <div class="border-b border-gray-200 py-5">
                            <p class="text-sm text-gray-500 mb-1">Email</p>
                            <h4 class="font-semibold text-gray-800">
                                <%= user.email %>
                            </h4>
                        </div>
                        <!-- Mobile -->
                        <div class="border-b border-gray-200 py-5 md:pl-10">
                            <p class="text-sm text-gray-500 mb-1">Mobile Number</p>
                            <h4 class="font-semibold text-gray-800">
                                <%= user.mobile %>
                            </h4>
                        </div>

                        <!-- Address -->
                        <div class="border-b border-gray-200 py-5 md:col-span-2">
                            <p class="text-sm text-gray-500 mb-1">Address</p>
                            <h4 class="font-semibold text-gray-800">
                                <%= user.address %>
                            </h4>
                        </div>

                        <!-- City -->
                        <div class="pt-5">
                            <p class="text-sm text-gray-500 mb-1">City</p>
                            <h4 class="font-semibold text-gray-800">
                                <%= user.city %>
                            </h4>
                        </div>

                        <!-- State -->
                        <div class="pt-5 md:pl-10">
                            <p class="text-sm text-gray-500 mb-1">State</p>
                            <h4 class="font-semibold text-gray-800">
                                <%= user.state %>
                            </h4>
                        </div>

                        <!-- Pincode -->
                        <div class="pt-5">
                            <p class="text-sm text-gray-500 mb-1">Pincode</p>
                            <h4 class="font-semibold text-gray-800">
                                <%= user.pincode %>
                            </h4>
                        </div>

                    </div>

                </div>
                <!-- ********************** -->
                <div class="bg-white rounded-3xl shadow-lg border border-gray-200 p-7">

                    <div class="flex items-center gap-3 mb-8">
                        <div class="w-11 h-11 bg-blue-50 rounded-xl flex items-center justify-center">
                            <i class="ri-briefcase-4-line text-blue-600 text-xl"></i>
                        </div>

                        <h2 class="text-2xl font-semibold">
                            Professional Information
                        </h2>
                    </div>

                    <div>

                        <h4 class="font-semibold mb-4">Skills</h4>

                        <div class="flex flex-wrap gap-3">

                            <div class="flex flex-wrap gap-3">

                                <% if (user.skills && user.skills.length> 0) { %>

                                    <% user.skills.forEach(skill=> { %>

                                        <span class="bg-blue-50 text-blue-600 px-4 py-2 rounded-full">
                                            <%= skill %>
                                        </span>

                                        <% }) %>

                                            <% } else { %>

                                                <p class="text-gray-500">No skills added</p>

                                                <% } %>

                            </div>

                        </div>

                        <div class="mt-10">

                            
                            <h4 class="font-semibold text-gray-800 mb-3">Resume</h4>

                            <% if (user.resume && user.resume.data) { %>

                                <div
                                    class="border border-gray-200 rounded-xl p-4 flex items-center justify-between bg-white">

                                    <!-- Resume Info -->
                                    <div class="flex items-center gap-3">

                                        <div class="w-11 h-11 bg-red-50 rounded-lg flex items-center justify-center">
                                            <i class="ri-file-pdf-2-line text-red-500 text-2xl"></i>
                                        </div>

                                        <div>
                                            <h5 class="font-medium text-gray-800">
                                                <%= user.resume.originalName || "Resume.pdf" %>
                                            </h5>

                                            <p class="text-sm text-gray-500">
                                                PDF Resume
                                            </p>
                                        </div>

                                    </div>


                                    <!-- Actions -->
                                    <div class="flex items-center gap-2">

                                        <!-- View -->
                                        <a href="/users/resume" target="_blank"
                                            class="w-10 h-10 border border-gray-200 rounded-lg flex items-center justify-center hover:bg-gray-50"
                                            title="View Resume">

                                            <i class="ri-eye-line text-lg text-gray-600"></i>

                                        </a>

                                        <!-- Download -->
                                        <a href="/users/resume" download
                                            class="w-10 h-10 border border-gray-200 rounded-lg flex items-center justify-center hover:bg-gray-50"
                                            title="Download Resume">

                                            <i class="ri-download-line text-lg text-gray-600"></i>

                                        </a>

                                    </div>

                                </div>

                                <% } else { %>

                                    <!-- No Resume -->
                                    <div class="border border-dashed border-gray-300 rounded-xl p-6 text-center">

                                        <i class="ri-file-pdf-line text-3xl text-gray-400"></i>

                                        <p class="text-sm text-gray-500 mt-2">
                                            Resume not uploaded
                                        </p>

                                    </div>

                                    <% } %>
                                        

                        </div>

                        <div class="mt-10">

                            <h4 class="font-semibold mb-3">About Me</h4>

                            <p class="text-gray-600 leading-7">
                                <%= user.aboutme %>
                            </p>

                        </div>

                    </div>

                </div>
            </div>

            <!-- *************** -->
            <div class="px-6 sm:px-8 lg:px-12">
                <div class="bg-white rounded-3xl shadow-lg border border-gray-200 p-7 mt-6 ">

                    <div class="flex items-center gap-3 mb-8">

                        <div class="w-11 h-11 bg-blue-50 rounded-xl flex items-center justify-center">

                            <i class="ri-shield-check-line text-blue-600 text-xl"></i>

                        </div>

                        <h2 class="text-2xl font-semibold">
                            Account Information
                        </h2>

                    </div>

                    <div class="grid grid-cols-3 gap-10">

                        <div>

                            <p class="text-sm text-gray-500">Account Type</p>

                            <h3 class="mt-1 font-semibold">
                                User
                            </h3>

                        </div>

                        <div>

                            <p class="text-sm text-gray-500">Member Since</p>

                            <h3 class="mt-1 font-semibold">
                                <%= user.createdAt.toDateString() %>
                            </h3>

                        </div>

                        <div>

                            <p class="text-sm text-gray-500">Last Updated</p>

                            <h3 class="mt-1 font-semibold">
                                Recently
                            </h3>

                        </div>

                    </div>

                </div>
            </div>

        </div>

    </div>
    <script>
        let menubtn = document.querySelector(".menubtn");
        let sidebar = document.querySelector(".sidebar");
        let cross = document.querySelector(".cross");
        let overlay = document.querySelector(".overlay")

        menubtn.addEventListener("click", () => {
            sidebar.classList.remove("-translate-x-full");
            overlay.classList.remove("hidden");
        });

        cross.addEventListener("click", () => {
            sidebar.classList.add("-translate-x-full")
            overlay.classList.add("hidden");

        })

        overlay.addEventListener("click", () => {
            sidebar.classList.add("-translate-x-full");
            overlay.classList.add("hidden");
        })

    </script>
</body>

</html>