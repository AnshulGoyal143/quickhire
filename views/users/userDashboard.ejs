<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.6.0/fonts/remixicon.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="overflow-x-hidden">
    <div class="w-full min-h-screen relative bg-gray-50">

        <div class="relative z-10 pb-20">

            <nav class="w-full h-16 bg-gray-100 flex items-center justify-between px-3 py-2 fixed top-0">
                <div class="flex items-center justify-between sm:gap-4 lg:gap-6">
                    <div class="menubtn">
                        <i class="ri-menu-fill text-2xl"></i>
                    </div>
                    <h2 class="text-lg md:text-xl font-semibold text-gray-800 ml-2">Users Dashboard</h2>
                </div>
                <div class="flex items-center gap-6">
                    <!-- notification k ley route bnana h -->
                    <a href=""><i class="ri-notification-3-line text-2xl"></i>
                    </a>
                    <div class="flex items-center gap-2">

                        <% if (user.profileImage && user.profileImage.data) { %>

                            <img src="data:<%= user.profileImage.contentType %>;base64,<%= user.profileImage.data.toString('base64') %>"
                                alt="Profile" class="h-10 w-10 rounded-full object-cover">

                            <% } else { %>

                                <div
                                    class="h-10 w-10 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-semibold">
                                    <%= user.fullname ? user.fullname.charAt(0).toUpperCase() : "U" %>
                                </div>

                                <% } %>

                                    <h2 class="text-xl font-semibold hidden md:block">
                                        <%= user.fullname %>
                                    </h2>

                                    <a href="">
                                        <i class="ri-arrow-down-wide-line"></i>
                                    </a>

                    </div>
                </div>
            </nav>
            <!-- *********** FOr the menu list div ********-->
            <div
                class=" sidebar fixed top-0 left-0 w-72 h-screen bg-white shadow-2xl z-50 -translate-x-full transition-transform duration-300 p-4">

                <div class="flex items-center ">
                    <img class="h-8"
                        src="https://static.vecteezy.com/system/resources/thumbnails/070/916/787/small/a-3d-render-of-a-light-blue-briefcase-with-the-word-job-in-white-letters-isolated-on-transparent-background-png.png"
                        alt="">
                    <h5 class="text-xl font-bold">Quick <span class="text-blue-500">Hire</span></h5>
                </div>
                <div class="cross flex justify-end ">
                    <i
                        class="ri-close-line text-2xl w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center cursor-pointer hover:bg-gray-200"></i>
                </div>
                <div class="list">
                    <ul class=" space-y-3">
                        <!-- yha pee user dashboard menu link attach krne h -->

                        <li
                            class="flex items-center gap-2 px-4 py-3 rounded-xl cursor-pointer bg-blue-100 text-blue-600 mb-1 mt-1">
                            <a href="/users/userDashboard">
                                <i class="ri-home-3-line text-xl"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>


                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100 ">
                            <a href="/users/userMyApplications">
                                <i class="ri-file-list-3-line text-xl"></i>
                                <span>My Applications</span>
                            </a>
                        </li>

                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100 ">
                            <a href="/users/userBrowseJobs">
                                <i class="ri-briefcase-line text-xl"></i>
                                <span>Browse Jobs</span>
                            </a>
                        </li>

                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">
                            <a href="/users/userProfile">
                                <i class="ri-user-3-line text-xl"></i>
                                <span>My Profile</span>
                            </a>
                        </li>

                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">
                            <a href="/users/ProfileEdit">
                                <i class="ri-edit-2-line text-xl"></i>
                                <span>Edit Profile</span>
                            </a>
                        </li>

                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer mt-8 hover:bg-gray-100">
                            <a href="/logout">
                                <i class="ri-logout-box-r-line text-xl"></i>
                                <span>Logout</span>
                            </a>
                        </li>


                    </ul>
                </div>
            </div>

            <div class="overlay fixed inset-0 bg-black/30 hidden z-40"></div>

            <!-- ***************text over picture************* -->

            <div class="textcontainer  px-4 sm:px-6 lg:px-8 py-2 pt-24 pb-10  transition-all duration-300">
                <div class="welcome mb-10">
                    <h4 class="text-xl md:text-2xl text-gray-700">Welcome back,</h4>
                    <h2 class="text-3xl sm:text-4xl lg:text-5xl mt-2 font-bold">
                        <%= user.fullname %>👋🏻
                    </h2>
                    <p class="text-base sm:text-lg lg:text-xl mt-3 text-gray-500">Track your application and manage your
                        profile</p>
                </div>

                <div class="routetext  grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
                    <!-- *********************** -->
                    <div
                        class="route bg-white rounded-3xl shadow-xl p-5 sm:6 flex items-center gap-5 hover:shadow-2xl transition min-h-[170px]">
                        <div
                            class="circleicon w-16 h-16 lg:w-20 lg:h-20 rounded-full bg-blue-100 flex items-center justify-center">
                            <i class="ri-file-list-3-line text-2xl lg:text-3xl text-blue-500"></i>
                        </div>
                        <div class="maintext flex-1">
                            <h2 class="text-2xl font-semibold">My Applications</h2>
                            <p class="text-gray-600 mt-2">View all companies you applied to</p>
                        </div>
                        <div class="routetag ">
                            <a href="/users/userMyApplications"><i
                                    class="ri-arrow-right-long-line text-3xl text-gray-500"></i></a>
                        </div>
                    </div>


                    <!-- ******************** -->
                    <div
                        class="route bg-white rounded-3xl shadow-xl p-6 flex items-center gap-5 hover:shadow-2xl transition min-h-[170px]">
                        <div
                            class=" circleicon lg:w-20 lg:h-20 h-16 w-16 rounded-full bg-green-200 flex items-center justify-center">
                            <i class="ri-user-3-line text-2xl lg:text-3xl text-green-700"></i>
                        </div>
                        <div class="maintext flex-1">
                            <h2 class="text-2xl font-semibold">My Profile</h2>
                            <p class="text-gray-600 mt-2">View your profile details</p>
                        </div>
                        <div class="routetag">
                            <a href="/users/userProfile"><i
                                    class="ri-arrow-right-long-line text-3xl text-gray-500"></i></a>
                        </div>
                    </div>

                    <!-- *************** -->
                    <div
                        class="route bg-white rounded-3xl shadow-xl p-6 flex items-center gap-5 hover:shadow-2xl transition min-h-[170px]">
                        <div
                            class=" circleicon lg:w-20 lg:h-20 w-16 h-16 rounded-full bg-purple-300 flex items-center justify-center">
                            <i class="ri-edit-2-line lg:text-3xl text-2xl text-purple-700"></i>
                        </div>
                        <div class="maintext flex-1">
                            <h2 class="text-2xl font-semibold">Edit Profile</h2>
                            <p class="text-gray-600 mt-2">Update your personal information</p>
                        </div>
                        <div class="routetag">
                            <a href="/users/ProfileEdit"><i
                                    class="ri-arrow-right-long-line text-3xl text-gray-500"></i></a>
                        </div>
                    </div>

                </div>
            </div>


            <!-- **************** JOB APPLICATION REPORT *************** -->

            <div class="px-4 sm:px-6 lg:px-8">
                <div class="jobapplication bg-white rounded-3xl shadow-xl p-6 mt-12   overflow-hidden ">

                    <div class="heading flex items-center justify-between mb-6 ">
                        <h2 class="text-xl">Recent Applications</h2>
                        <a href="" class="text-blue-600 font-medium hover:underline text-lg">View All</a>
                    </div>

                    <% if (applications && applications.length> 0) { %>

                        <div class="tables overflow-x-auto">

                            <table class="w-full min-w-[950px]">

                                <thead class="bg-gray-50 border-b">
                                    <tr>
                                        <th class="text-left px-6 py-4 text-sm font-semibold text-gray-600">
                                            Company
                                        </th>

                                        <th class="text-left px-6 py-4 text-sm font-semibold text-gray-600">
                                            Job Role
                                        </th>

                                        <th class="text-left px-6 py-4 text-sm font-semibold text-gray-600">
                                            Applied On
                                        </th>

                                        <th class="text-left px-6 py-4 text-sm font-semibold text-gray-600">
                                            Status
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>

                                    <% applications.forEach(application=> { %>

                                        <tr class="border-b hover:bg-gray-50 transition">

                                            <td class="px-6 py-5 font-medium">
                                                <%= application.company.companyName %>
                                            </td>

                                            <td class="px-6 py-5 text-gray-600">
                                                <%= application.job.jobTitle %>
                                            </td>

                                            <td class="px-6 py-5 text-gray-600">
                                                <%= new Date(application.appliedAt).toLocaleDateString("en-IN", {
                                                    day: "2-digit" , month: "short" , year: "numeric" }) %>
                                            </td>

                                            <td class="py-5 px-6">

                                                <% if (application.status==="Applied" ) { %>

                                                    <span
                                                        class="bg-blue-100 text-blue-700 px-3 py-1 rounded-full text-sm font-semibold">
                                                        Applied
                                                    </span>

                                                    <% } else if (application.status==="Under Review" ) { %>

                                                        <span
                                                            class="bg-yellow-100 text-yellow-700 px-3 py-1 rounded-full text-sm font-semibold">
                                                            Under Review
                                                        </span>

                                                        <% } else if (application.status==="Shortlisted" ) { %>

                                                            <span
                                                                class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm font-semibold">
                                                                Shortlisted
                                                            </span>

                                                            <% } else if (application.status==="Rejected" ) { %>

                                                                <span
                                                                    class="bg-red-100 text-red-700 px-3 py-1 rounded-full text-sm font-semibold">
                                                                    Rejected
                                                                </span>

                                                                <% } else if (application.status==="Selected" ) { %>

                                                                    <span
                                                                        class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm font-semibold">
                                                                        Selected
                                                                    </span>

                                                                    <% } %>

                                            </td>

                                        </tr>

                                        <% }) %>

                                </tbody>

                            </table>

                        </div>

                        <% } else { %>

                            <div class="text-center py-16">

                                <i class="ri-file-list-3-line text-5xl text-gray-300"></i>

                                <h2 class="text-xl font-semibold text-gray-700 mt-4">
                                    No Applications Yet
                                </h2>

                                <p class="text-gray-500 mt-2">
                                    You haven't applied for any jobs yet.
                                </p>

                            </div>

                            <% } %>


                </div>
            </div>
        </div>

    </div>


    <script>
        let menubtn = document.querySelector(".menubtn");
        let sidebar = document.querySelector(".sidebar");
        let cross = document.querySelector(".cross");
        let overlay = document.querySelector(".overlay")

        menubtn.addEventListener("click", () => {
            sidebar.classList.remove("-translate-x-full");
            overlay.classList.remove("hidden");
        });

        cross.addEventListener("click", () => {
            sidebar.classList.add("-translate-x-full")
            overlay.classList.add("hidden");

        })

        overlay.addEventListener("click", () => {
            sidebar.classList.add("-translate-x-full");
            overlay.classList.add("hidden");
        })

    </script>
</body>

</html>