<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.6.0/fonts/remixicon.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="overflow-x-hidden">
    <div class="w-full min-h-screen relative">
        <div class="w-full min-h-screen relative bg-cover bg-center bg-no-repeat  inset-0"
            style="background-image: url('/public/images/WhatsApp\ Image\ 2026-07-09\ at\ 3.40.54\ PM.jpeg');">

            <div class="absolute inset-0 bg-white/80"></div>
            <div class="relative z-10 pt-24 ">

                <nav class="w-full h-16 bg-gray-100 flex items-center justify-between px-3 py-2 fixed top-0">
                    <div class="flex items-center justify-between sm:gap-4 lg:gap-6">
                        <div class="menubtn">
                            <i class="ri-menu-fill text-2xl"></i>
                        </div>
                        <h2 class="text-lg md:text-xl font-semibold text-gray-800 ml-2">My Profile</h2>
                    </div>
                    <div class="flex items-center gap-6">
                        <!-- notification k ley route bnana h -->
                        <a href=""><i class="ri-notification-3-line text-2xl"></i>
                        </a>
                        <div class="flex items-center gap-2">
                            <img class="h-10 w-11 rounded-full"
                                src="https://static.vecteezy.com/system/resources/thumbnails/053/964/117/small/a-silhouette-of-a-person-with-a-circular-head-and-a-minimalistic-body-structure-showcasing-a-simple-design-png.png"
                                alt="">
                            <h2 class="text-xl font-semibold hidden md:block ">Admin</h2>
                            <a href=""><i class="ri-arrow-down-wide-line"></i></a>
                        </div>
                    </div>
                </nav>
                <!-- *********** FOr the menu list div ********-->
                <div
                    class=" sidebar fixed top-0 left-0 w-72 h-screen bg-white shadow-2xl z-50 -translate-x-full transition-transform duration-300 p-4">

                    <div class="flex items-center ">
                        <img class="h-8"
                            src="https://static.vecteezy.com/system/resources/thumbnails/070/916/787/small/a-3d-render-of-a-light-blue-briefcase-with-the-word-job-in-white-letters-isolated-on-transparent-background-png.png"
                            alt="">
                        <h5 class="text-xl font-bold">Quick <span class="text-blue-500">Hire</span></h5>
                    </div>
                    <div class="cross flex justify-end ">
                        <i
                            class="ri-close-line text-2xl w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center cursor-pointer hover:bg-gray-200"></i>
                    </div>
                    <div class="list">
                        <ul class=" space-y-3">
                            <!-- yha pee user dashboard menu link attach krne h -->

                            <li
                                class="flex items-center gap-2 px-4 py-3 rounded-xl cursor-pointer hover:bg-gray-100  mb-1">
                                <a href="/company/companyDashboard">
                                    <i class="ri-home-3-line text-xl"></i>
                                    <span>Dashboard</span>
                                </a>
                            </li>


                            <li
                                class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer bg-blue-100 text-blue-600  ">
                                <a href="company/companyMyProfile">
                                    <i class="ri-group-line text-xl"></i>
                                    <span>My Profile</span>
                                </a>
                            </li>


                            <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">
                                <a href="/company/PostJob">
                                    <i class="ri-file-add-line text-xl"></i>
                                    <span>Post a Job</span>
                                </a>
                            </li>

                            <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">
                                <a href="/company/companyJobPosted">
                                    <i class="ri-briefcase-4-line text-xl"></i>
                                    <span>Jobs Posts</span>
                                </a>
                            </li>


                            <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">
                                <a href="/company/companyApplicants">
                                    <i class="ri-team-line text-xl"></i>
                                    <span>Applicants</span>
                                </a>
                            </li>


                            <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">
                                <a href="/company/companyApplication">
                                    <i class="ri-file-list-3-line text-xl"></i>
                                    <span>Applications</span>
                                </a>
                            </li>

                            <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">
                                <a href="">
                                    <i class="ri-bookmark-line text-xl"></i>
                                    <span>Saved Candidates</span>
                                </a>
                            </li>

                            <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">
                                <a href="">
                                    <i class="ri-chat-3-line text-xl"></i>
                                    <span>Messages</span>
                                </a>
                            </li>

                            <li
                                class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer mt-8 hover:bg-gray-100">
                                <a href="/company/logout">
                                    <i class="ri-logout-box-r-line text-xl"></i>
                                    <span>Logout</span>
                                </a>
                            </li>


                        </ul>
                    </div>
                </div>

                <div class="overlay fixed inset-0 bg-black/30 hidden z-40"></div>


                <div class=" px-4 max-w-5xl mx-auto pb-12">
                    <h2 class="text-4xl font-bold mb-2 px-2">Edit Profile</h2>
                    <p class="text-gray-700 text-xl mb-5 px-2">Update your personal information</p>

                    <div class="bg-white shadow-lg rounded-3xl p-8 mt-6 pb-12">


                        <!-- ********************************* -->
                        <form action="/company/EditProfile" method="post" enctype="multipart/form-data">

                            <div>
                                <h2 class="text-xl font-semibold">Profile Pic</h2>

                                <div class="flex items-center gap-8 mt-8 pb-8 border-b border-gray-200">

                                    <!-- Preview -->
                                    <div id="previewBox"
                                        class="w-24 h-24 rounded-xl border-2 border-dashed border-gray-300 flex items-center justify-center overflow-hidden bg-gray-50">

                                        <% if (company.companyProfile && company.companyProfile.data) { %>

                                            <!-- Existing Profile Pic -->
                                            <img id="logoPreview" src="/company/company-profile" alt="Company Profile"
                                                class="w-full h-full object-cover">

                                            <!-- Hidden until new image is selected -->
                                            <i id="uploadIcon"
                                                class="ri-image-add-line text-4xl text-gray-400 hidden"></i>

                                            <% } else { %>

                                                <!-- No Profile Pic -->
                                                <i id="uploadIcon" class="ri-image-add-line text-4xl text-gray-400"></i>

                                                <img id="logoPreview" src="" alt="Company Profile"
                                                    class="hidden w-full h-full object-cover">

                                                <% } %>

                                    </div>

                                    <div>

                                        <!-- Hidden Input -->
                                        <input type="file" id="logoInput" name="companyProfile"
                                            accept="image/png,image/jpeg" class="hidden">

                                        <!-- Upload Button -->
                                        <button type="button" id="uploadBtn"
                                            onclick="document.getElementById('logoInput').click()"
                                            class="px-5 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition flex items-center gap-2">

                                            <i class="ri-upload-cloud-2-line"></i>

                                            <span id="btnText">
                                                <%= company.companyProfile && company.companyProfile.data ? "Change Logo"
                                                    : "Upload Logo" %>
                                            </span>

                                        </button>

                                        <p class="text-sm text-gray-500 mt-2">
                                            PNG, JPG • Max 2 MB
                                        </p>

                                    </div>

                                </div>
                            </div>


                            <!-- ***************************************** -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-8 mt-6 gap-6">

                                <div class="label1">
                                    <label class="text-lg font-medium mb-2 block ">Company Name</label>
                                    <input
                                        class=" w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:ring-1 focus:ring-blue-500 text-gray-800 placeholder:text-gray-500"
                                        type="text" placeholder="Enter Company Name" name="companyName" value="<%= company?.companyName || '' %>" > 
                                </div>

                                <div class="label2">
                                    <label class="text-lg font-medium">Industry</label>

                                    <select name="industry"
                                        class="w-full border border-gray-300 rounded-xl px-4 py-3 mt-2 outline-none focus:ring-2 focus:ring-blue-500 text-gray-800 placeholder:text-gray-500">
                                        <option value="" selected disabled>Select Industry</option>
                                        <option  <%= company?.industry === "Information Technology" ? "selected" : "" %> >Information Technology</option>
                                        <option   <%= company?.industry === "Software Development" ? "selected" : "" %> >Software Development</option>
                                        <option    <%= company?.industry === "Finance" ? "selected" : "" %>>Finance</option>
                                        <option    <%= company?.industry === "Healthcare" ? "selected" : "" %>>Healthcare</option>
                                        <option    <%= company?.industry === "Education" ? "selected" : "" %> >Education</option>
                                        <option    <%= company?.industry === "E-commerce" ? "selected" : "" %>>E-commerce</option>
                                        <option   <%= company?.industry === "Manufacturing" ? "selected" : "" %>>Manufacturing</option>
                                        <option   <%= company?.industry === "Marketing" ? "selected" : "" %>>Marketing</option>
                                        <option   <%= company?.industry === "Real Estate" ? "selected" : "" %>>Real Estate</option>
                                        <option   <%= company?.industry === "Other" ? "selected" : "" %>>Other</option>
                                    </select>
                                </div>

                                <div class="label3">
                                    <label class="text-lg font-medium mb-2 block">Company Email</label>
                                    <input
                                        class="  w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:ring-1 focus:ring-blue-500 text-gray-800 placeholder:text-gray-500"
                                        type="email" placeholder="Enter Company Email" name="companyEmail" value="<%= company?.companyEmail || '' %>"> 
                                </div>

                                <div class="label4">
                                    <label class="text-lg font-medium mb-2 block" for="">Company Phone</label>
                                    <input
                                        class="  w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:ring-1 focus:ring-blue-500 text-gray-800 placeholder:text-gray-500"
                                        type="tel" placeholder="Enter Company Phone Number" name="phone" value="<%= company?.phone || '' %>"> 
                                </div>

                                <div class="label5">
                                    <label class="text-lg font-medium">Company Size</label>

                                    <select name="companySize"
                                        class="w-full border border-gray-300  rounded-lg px-4 py-3 mt-2 focus:outline-none focus:ring-2 focus:ring-blue-500 text-gray-800 placeholder:text-gray-500">
                                        <option value="" selected disabled>Select Company Size</option>
                                        <option   <%= company?.companySize === "1 - 10 Employees" ? "selected" : "" %> >1 - 10 Employees</option>
                                        <option <%= company?.companySize === "11 - 50 Employees" ? "selected" : "" %>>11 - 50 Employees</option>
                                        <option <%= company?.companySize === "51 - 200 Employees" ? "selected" : "" %>>51 - 200 Employees</option>
                                        <option <%= company?.companySize === "201 - 500 Employees" ? "selected" : "" %>>201 - 500 Employees</option>
                                        <option <%= company?.companySize === "501 - 1000 Employees" ? "selected" : "" %>>501 - 1000 Employees</option>
                                        <option <%= company?.companySize === "1000+ Employees" ? "selected" : "" %>>1000+ Employees</option>
                                    </select>

                                </div>

                                <div class="label6">
                                    <label class="text-lg font-medium mb-2 block" for="">Founded Year</label>
                                    <input
                                        class="  w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:ring-1 focus:ring-blue-500 text-gray-800 placeholder:text-gray-500"
                                        type="number" placeholder="e.g. 2022" maxlength="4" name="foundedYear" value="<%= company?.foundedYear || '' %>"> 
                                </div>



                                <div class="label7">
                                    <label class="text-lg font-medium mb-2 block" for="">Website</label>
                                    <input
                                        class="  w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:ring-1 focus:ring-blue-500 text-gray-800 placeholder:text-gray-500"
                                        type="url" placeholder="https://www.company.com" name="website" value="<%= company?.website || '' %>"> 

                                </div>

                                <div class="label8">
                                    <label class="text-lg font-medium mb-2 block" for="">Location</label>
                                    <input
                                        class="  w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:ring-1 focus:ring-blue-500 text-gray-800 placeholder:text-gray-500"
                                        type="text" placeholder="Enter Company Location" name="location" value="<%= company?.location || '' %>"> 
                                </div>


                                <div>
                                    <label class="text-lg font-medium mb-2 block" for="">About Company </label>
                                    <textarea
                                        class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:ring-1 focus:ring-blue-500 resize-none h-32 text-gray-700 placeholder:text-gray-500"
                                        placeholder="Write a short description about your company"
                                        name="about"> <%= company?.about || '' %></textarea>
                                </div>


                            </div>



                            <div class="flex justify-end gap-4 mt-8">
                                <button type="button"
                                    class="px-6 py-3 rounded-xl border border-gray-300 hover:bg-gray-100">
                                    Cancel
                                </button>

                                <button type="submit"
                                    class="px-6 py-3 rounded-xl bg-blue-600 text-white hover:bg-blue-700">
                                    Save Changes
                                </button>
                            </div>

                        </form>
                    </div>
                </div>

            </div>
            <script>
                let menubtn = document.querySelector(".menubtn");
                let sidebar = document.querySelector(".sidebar");
                let cross = document.querySelector(".cross");
                let overlay = document.querySelector(".overlay")



                const input = document.getElementById("logoInput");
                const preview = document.getElementById("logoPreview");
                const icon = document.getElementById("uploadIcon");
                const btnText = document.getElementById("btnText");

                input.addEventListener("change", function () {

                    const file = this.files[0];

                    if (file) {

                        preview.src = URL.createObjectURL(file);

                        preview.classList.remove("hidden");

                        icon.classList.add("hidden");

                        btnText.textContent = "Change Logo";

                    }

                });



                menubtn.addEventListener("click", () => {
                    sidebar.classList.remove("-translate-x-full");
                    overlay.classList.remove("hidden");
                });

                cross.addEventListener("click", () => {
                    sidebar.classList.add("-translate-x-full")
                    overlay.classList.add("hidden");

                })

                overlay.addEventListener("click", () => {
                    sidebar.classList.add("-translate-x-full");
                    overlay.classList.add("hidden");
                })

            </script>
</body>

</html>