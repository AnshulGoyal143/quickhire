<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.6.0/fonts/remixicon.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="overflow-x-hidden">
    <div class="w-full min-h-screen relative bg-gray-50">


        <div class="relative z-10 ">

            <nav class="w-full h-16 bg-gray-100 flex items-center justify-between px-3 py-2 fixed top-0">
                <div class="flex items-center justify-between sm:gap-4 lg:gap-6">
                    <div class="menubtn">
                        <i class="ri-menu-fill text-2xl"></i>
                    </div>
                    <h2 class="text-lg md:text-xl font-semibold text-gray-800 ml-2">Dashboard</h2>
                </div>
                <div class="flex items-center gap-6">
                    <!-- notification k ley route bnana h -->
                    <a href=""><i class="ri-notification-3-line text-2xl"></i>
                    </a>
                    <div class="flex items-center gap-2">
                        <img class="h-10 w-11 rounded-full"
                            src="https://static.vecteezy.com/system/resources/thumbnails/053/964/117/small/a-silhouette-of-a-person-with-a-circular-head-and-a-minimalistic-body-structure-showcasing-a-simple-design-png.png"
                            alt="">
                        <h2 class="text-xl font-semibold hidden md:block ">Admin</h2>
                        <a href=""><i class="ri-arrow-down-wide-line"></i></a>
                    </div>
                </div>
            </nav>
            <!-- *********** FOr the menu list div ********-->
            <div
                class=" sidebar fixed top-0 left-0 w-72 h-screen bg-white shadow-2xl z-50 -translate-x-full transition-transform duration-300 p-4">

                <div class="flex items-center ">
                    <img class="h-8"
                        src="https://static.vecteezy.com/system/resources/thumbnails/070/916/787/small/a-3d-render-of-a-light-blue-briefcase-with-the-word-job-in-white-letters-isolated-on-transparent-background-png.png"
                        alt="">
                    <h5 class="text-xl font-bold">Quick <span class="text-blue-500">Hire</span></h5>
                </div>

                <div class="cross flex justify-end mb-3">
                    <i
                        class="ri-close-line text-2xl w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center cursor-pointer hover:bg-gray-200"></i>
                </div>
                <div class="list">
                    <ul class=" space-y-3">
                        <!-- yha pee user dashboard menu link attach krne h -->

                        <li
                            class="flex items-center gap-2 px-4 py-3 rounded-xl cursor-pointer bg-blue-100 text-blue-600 mb-1">
                            <a href="/admin/adminDashboard">
                                <i class="ri-home-3-line text-xl"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>


                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100 ">
                            <a href="/admin/adminUserDashboard">
                                <i class="ri-group-line text-xl"></i>
                                <span>Users</span>
                            </a>
                        </li>


                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">
                            <a href="/admin/adminCompanyDashboard">
                                <i class="ri-building-2-line text-xl"></i>
                                <span>Companies</span>
                            </a>
                        </li>


                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">
                            <a href="/admin/adminJobDashboard">
                                <i class="ri-briefcase-4-line text-xl"></i>
                                <span>Jobs</span>
                            </a>
                        </li>


                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">
                            <a href="">
                                <i class="ri-file-list-3-line text-xl"></i>
                                <span>Applications</span>
                            </a>
                        </li>



                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer mt-8 hover:bg-gray-100">
                            <a href="/admin/logout">
                                <i class="ri-logout-box-r-line text-xl"></i>
                                <span>Logout</span>
                            </a>
                        </li>


                    </ul>
                </div>
            </div>

            <div class="overlay fixed inset-0 bg-black/30 hidden z-40"></div>

            <!-- ***************text over picture************* -->

            <div class="textcontainer  px-6 sm:px-8 lg:px-12 py-2 pt-32 pb-10  transition-all duration-300">
                <div class="welcome mb-8">
                    <h4 class="text-3xl sm:text-4xl lg:text-5xl mt-2 font-bold">Welcome back, Admin!</h4>
                    <p class="text-base sm:text-lg lg:text-xl mt-3 text-gray-700">Here's what's happening on your
                        platform</p>
                </div>
                <!-- ************************CARDS ******************* -->
                <div class="routetext  grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">
                    <!-- *********************** -->
                    <div
                        class="route bg-white rounded-3xl shadow-xl p-5 sm:p-6  hover:shadow-2xl transition min-h-[150px]">

                        <div class=" flex items-center gap-4">
                            <div
                                class="circleicon w-14 h-14 lg:w-16 lg:h-16 rounded-full bg-blue-100 flex items-center justify-center">
                                <i class="ri-group-line text-2xl lg:text-3xl text-blue-500"></i>
                            </div>
                            <div class="maintext">
                                <h2 class="text-xl text-gray-500">Users</h2>
                                <p class="text-4xl font-bold mt-1">123</p>
                            </div>
                        </div>
                        <div class="routetag mt-3 ">
                            <a href="" class="text-base font-medium text-blue-600 block text-center">
                                View all users</a>

                        </div>
                    </div>


                    <!-- ******************** -->
                    <div
                        class="route bg-white rounded-3xl shadow-xl p-5 sm:p-6  hover:shadow-2xl transition min-h-[150px]">

                        <div class=" flex items-center gap-4">
                            <div
                                class="circleicon w-14 h-14 lg:w-16 lg:h-16 rounded-full bg-green-200 flex items-center justify-center">
                                <i class="ri-building-2-line text-2xl lg:text-3xl text-green-600"></i>
                            </div>
                            <div class="maintext">
                                <h2 class="text-xl text-gray-500">Companies</h2>
                                <p class="text-4xl font-bold mt-1">38</p>
                            </div>
                        </div>
                        <div class="routetag mt-3 ">
                            <a href="" class="text-base font-medium text-blue-600 block text-center">
                                View all companies</a>

                        </div>
                    </div>

                    <!-- *************** -->
                    <div
                        class="route bg-white rounded-3xl shadow-xl p-5 sm:p-6  hover:shadow-2xl transition min-h-[150px]">

                        <div class=" flex items-center gap-4">
                            <div
                                class="circleicon w-14 h-14 lg:w-16 lg:h-16 rounded-full bg-purple-300 flex items-center justify-center">
                                <i class="ri-briefcase-4-line text-2xl lg:text-3xl text-purple-800"></i>
                            </div>
                            <div class="maintext">
                                <h2 class="text-xl text-gray-500">Jobs</h2>
                                <p class="text-4xl font-bold mt-1">79</p>
                            </div>
                        </div>
                        <div class="routetag mt-3 ">
                            <a href="" class="text-base font-medium text-blue-600 block text-center">
                                View all jobs</a>

                        </div>
                    </div>

                    <!-- *********************** -->
                    <div
                        class="route bg-white rounded-3xl shadow-xl p-5 sm:p-6  hover:shadow-2xl transition min-h-[150px]">

                        <div class=" flex items-center gap-4">
                            <div
                                class="circleicon w-14 h-14 lg:w-16 lg:h-16 rounded-full bg-orange-200 flex items-center justify-center">
                                <i class="ri-file-list-3-line text-2xl lg:text-3xl text-orange-500"></i>
                            </div>
                            <div class="maintext">
                                <h2 class="text-xl text-gray-500">Applications</h2>
                                <p class="text-4xl font-bold mt-1">223</p>
                            </div>
                        </div>
                        <div class="routetag mt-3">
                            <a href="" class="text-base font-medium text-blue-600 block text-center">
                                View all applications</a>

                        </div>
                    </div>


                </div>
            </div>

            <div class="tables grid grid-cols-1 xl:grid-cols-2 gap-6 px-6 pb-10 ">
                <div class="companies bg-white rounded-3xl shadow-xl p-6 mt-6 min-h-[420px]  overflow-hidden">

                    <div class="heading flex items-center justify-between mb-6 ">
                        <h2 class="text-xl font-semibold">Recent Companies</h2>
                        <a href="" class="text-blue-600 font-medium hover:underline text-lg">View All</a>
                    </div>
                    <div class="tables overflow-x-auto">
                        <table class="w-full  ">
                            <!-- heading********** -->
                            <thead class="border-b bg-gray-50">
                                <tr>
                                    <th class="text-left py-4 px-4 font-semibold">Company Name</th>
                                    <th class="text-left py-4 px-4 font-semibold">Email</th>
                                    <th class="text-left py-4 px-4 font-semibold">Registered On</th>
                                </tr>
                            </thead>
                            <!-- *****data********* -->
                            <tbody>

                                <% if (company.length> 0) { %>

                                    <% company.forEach(company=> { %>

                                        <tr class="border-b hover:bg-gray-50 transition font-medium text-gray-900">

                                            <td class="py-4 px-4">
                                                <%= company.companyName %>
                                            </td>

                                            <td class="py-4 px-4">
                                                <%= company.companyEmail %>
                                            </td>

                                            <td class="py-4 px-4">
                                                <%= new Date(company.createdAt).toLocaleDateString("en-IN", {
                                                    day: "2-digit" , month: "short" , year: "numeric" }) %>
                                            </td>

                                        </tr>

                                        <% }) %>

                                            <% } else { %>

                                                <tr>
                                                    <td colspan="3" class="py-10 text-center text-gray-500">
                                                        No companies registered yet.
                                                    </td>
                                                </tr>

                                                <% } %>

                            </tbody>
                        </table>

                    </div>

                </div>


                <!-- *******************RECENT USERS **************** -->

                <div class="users bg-white rounded-3xl shadow-xl p-6 mt-6 min-h-[420px] overflow-hidden">

                    <div class="heading flex items-center justify-between mb-6 ">
                        <h2 class="text-xl font-semibold">Recent Users</h2>
                        <a href="" class="text-blue-600 font-medium hover:underline text-lg">View All</a>
                    </div>
                    <div class="tables overflow-x-auto">
                        <table class="w-full  ">
                            <!-- heading********** -->
                            <thead class="border-b bg-gray-50 text-gray-600">
                                <tr>
                                    <th class="text-left py-4 px-4 font-semibold">User Name</th>
                                    <th class="text-left py-4 px-4 font-semibold">Email</th>
                                    <th class="text-left py-4 px-4 font-semibold">Registered On</th>
                                </tr>
                            </thead>
                            <!-- *****data********* -->
                            <tbody>

                                <% if (user.length> 0) { %>

                                    <% user.forEach(user=> { %>

                                        <tr class="border-b hover:bg-gray-50 transition font-medium text-gray-900">

                                            <td class="py-4 px-4">
                                                <%= user.fullname %>
                                            </td>

                                            <td class="py-4 px-4">
                                                <%= user.email %>
                                            </td>

                                            <td class="py-4 px-4">
                                                <%= new Date(user.createdAt).toLocaleDateString("en-IN", {
                                                    day: "2-digit" , month: "short" , year: "numeric" }) %>
                                            </td>

                                        </tr>

                                        <% }) %>

                                            <% } else { %>

                                                <tr>
                                                    <td colspan="3" class="py-10 text-center text-gray-500">
                                                        No users registered yet.
                                                    </td>
                                                </tr>

                                                <% } %>

                            </tbody>
                        </table>

                    </div>

                </div>

            </div>



        </div>

    </div>
    <script>
        let menubtn = document.querySelector(".menubtn");
        let sidebar = document.querySelector(".sidebar");
        let cross = document.querySelector(".cross");
        let overlay = document.querySelector(".overlay")

        menubtn.addEventListener("click", () => {
            sidebar.classList.remove("-translate-x-full");
            overlay.classList.remove("hidden");
        });

        cross.addEventListener("click", () => {
            sidebar.classList.add("-translate-x-full")
            overlay.classList.add("hidden");

        })

        overlay.addEventListener("click", () => {
            sidebar.classList.add("-translate-x-full");
            overlay.classList.add("hidden");
        })

    </script>
</body>

</html>