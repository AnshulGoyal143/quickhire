<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Confirm Delete</title>

<script src="https://cdn.tailwindcss.com"></script>

<link
    href="https://cdn.jsdelivr.net/npm/remixicon@4.6.0/fonts/remixicon.css"
    rel="stylesheet"
>

</head>

<body class="bg-gray-50 min-h-screen flex items-center justify-center px-4">


<div class="bg-white w-full max-w-md rounded-2xl shadow-lg p-8 text-center">

    <!-- Icon -->
    <div class="w-16 h-16 mx-auto rounded-full bg-red-100 flex items-center justify-center">
        <i class="ri-delete-bin-6-line text-3xl text-red-600"></i>
    </div>

    <!-- Heading -->
    <h1 class="text-2xl font-semibold text-gray-800 mt-5">
        Delete Confirmation
    </h1>

    <!-- Message -->
    <p class="text-gray-500 mt-3 leading-6">
        Are you sure you want to delete this?
        This action cannot be undone.
    </p>

    <!-- Buttons -->
    <div class="flex gap-3 mt-7">

    <!-- Cancel -->
    <a
        href="/company/companyApplications"
        class="flex-1 py-3 rounded-xl border border-gray-300
               text-gray-700 font-medium hover:bg-gray-100
               transition text-center"
    >
        Cancel
    </a>

    <!-- Delete -->
    <button
        onclick="deleteApplication()"
        type="button"
        class="flex-1 py-3 rounded-xl bg-red-600
               text-white font-medium hover:bg-red-700
               transition"
    >
        Delete
    </button>

</div>

</div>

<script>
    async function deleteApplication() {

    try {

        const response = await fetch(`/company/delete/<%= application._id %>`, {
            method: "DELETE"
        });

        const data = await response.json();

        if (data.success) {
            window.location.href = "/company/companyApplications";
        } else {
            window.location.href = "/company/companyApplications";
        }

    } catch (error) {

        console.error("Delete Error:", error);

        window.location.href = "/company/companyApplications";
    }
}
</script>

</body>
</html>
