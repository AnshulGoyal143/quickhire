<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin - Application Details</title>

    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.6.0/fonts/remixicon.css" rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>


<body class="overflow-x-hidden bg-gray-50">

    <div class="w-full min-h-screen relative">


          <!-- ================= NAVBAR ================= -->
            <nav class="w-full h-16 bg-gray-100 flex items-center justify-between px-3 py-2 fixed top-0 left-0 z-30">

                <!-- Left -->
                <div class="flex items-center gap-4">

                    <div
                        class="menubtn cursor-pointer w-10 h-10 rounded-lg hover:bg-gray-200 flex items-center justify-center transition">
                        <i class="ri-menu-fill text-2xl text-gray-700"></i>
                    </div>

                    <h2 class="text-lg md:text-xl font-semibold text-gray-800">
                        Applications
                    </h2>

                </div>


                <!-- Right -->
                <div class="flex items-center gap-5">

                    <!-- Notification -->
                    <a href=""
                        class="w-10 h-10 rounded-full hover:bg-gray-200 flex items-center justify-center transition">
                        <i class="ri-notification-3-line text-2xl text-gray-700"></i>
                    </a>


                    <!-- Admin -->
                    <div class="flex items-center gap-2">

                        <div
                            class="h-11 w-11 rounded-full overflow-hidden bg-blue-100 flex items-center justify-center">

                            <% if (admin?.profileImage && admin.profileImage !=="default-admin.png" ) { %>

                                <img src="/admin/admin-profile" alt="Admin Profile" class="w-full h-full object-cover">

                                <% } else { %>

                                    <i class="ri-admin-fill text-2xl text-blue-500"></i>

                                    <% } %>

                        </div>

                        <h2 class="text-xl font-semibold hidden md:block text-gray-800">
                            Admin
                        </h2>

                        <a href="">
                            <i class="ri-arrow-down-wide-line text-gray-600"></i>
                        </a>

                    </div>

                </div>

            </nav>


            <!-- ================= SIDEBAR ================= -->
            <div
                class="sidebar fixed top-0 left-0 w-72 h-screen bg-white shadow-2xl z-[60] -translate-x-full transition-transform duration-300 p-4">

                <!-- Logo -->
                <div class="flex items-center">

                    <img class="h-8"
                        src="https://static.vecteezy.com/system/resources/thumbnails/070/916/787/small/a-3d-render-of-a-light-blue-briefcase-with-the-word-job-in-white-letters-isolated-on-transparent-background-png.png"
                        alt="">

                    <h5 class="text-xl font-bold">
                        Quick <span class="text-blue-500">Hire</span>
                    </h5>

                </div>


                <!-- Close -->
                <div class="cross flex justify-end mb-3">

                    <i
                        class="ri-close-line text-2xl w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center cursor-pointer hover:bg-gray-200">
                    </i>

                </div>


                <!-- Menu -->
                <div class="list">

                    <ul class="space-y-3">

                        <!-- Dashboard -->
                        <li class="flex items-center gap-2 px-4 py-3 rounded-xl cursor-pointer hover:bg-gray-100">

                            <a href="/admin/adminDashboard" class="flex items-center gap-2 w-full">

                                <i class="ri-home-3-line text-xl"></i>
                                <span>Dashboard</span>

                            </a>

                        </li>


                        <!-- Users -->
                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">

                            <a href="/admin/adminUserDashboard" class="flex items-center gap-2 w-full">

                                <i class="ri-group-line text-xl"></i>
                                <span>Users</span>

                            </a>

                        </li>


                        <!-- Companies -->
                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">

                            <a href="/admin/adminCompanyDashboard" class="flex items-center gap-2 w-full">

                                <i class="ri-building-2-line text-xl"></i>
                                <span>Companies</span>

                            </a>

                        </li>


                        <!-- Jobs -->
                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">

                            <a href="/admin/adminJobDashboard" class="flex items-center gap-2 w-full">

                                <i class="ri-briefcase-4-line text-xl"></i>
                                <span>Jobs</span>

                            </a>

                        </li>


                        <!-- Applications Active -->
                        <li
                            class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer bg-blue-100 text-blue-600">

                            <a href="/admin/adminApplicationDashboard" class="flex items-center gap-2 w-full">

                                <i class="ri-file-list-3-line text-xl"></i>
                                <span>Applications</span>

                            </a>

                        </li>


                        <!-- Profile -->
                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">

                            <a href="/admin/adminProfilePage" class="flex items-center gap-2 w-full">

                                <i class="ri-user-line text-xl"></i>
                                <span>My Profile</span>

                            </a>

                        </li>


                        <!-- Logout -->
                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer mt-8 hover:bg-gray-100">

                            <a href="/admin/logout" class="flex items-center gap-2 w-full">

                                <i class="ri-logout-box-r-line text-xl"></i>
                                <span>Logout</span>

                            </a>

                        </li>

                    </ul>

                </div>

            </div>


        <!-- OVERLAY -->

        <div
            class="overlay fixed inset-0 bg-black/30 hidden z-40">
        </div>


        <!-- ================= MAIN ================= -->

        <main class="px-5 sm:px-8 lg:px-12 pt-24 pb-12">


            <!-- BACK -->

            <div class="mb-4">

                <a href="/admin/adminApplications"
                   class="inline-flex items-center gap-2
                          text-gray-600 hover:text-blue-600">

                    <i class="ri-arrow-left-line text-lg"></i>

                    <span class="font-medium">
                        Back to Applications
                    </span>

                </a>

            </div>


            <!-- HEADING -->

            <div class="flex flex-col md:flex-row
                        md:items-center md:justify-between gap-4">

                <div>

                    <h1 class="text-3xl sm:text-4xl font-bold text-gray-800">
                        Application Details
                    </h1>

                    <p class="text-gray-600 mt-2">
                        View and manage complete application information.
                    </p>

                </div>


                <!-- ADMIN ACTIONS -->

                <div class="flex items-center gap-3">

                    <% if (application.resume && application.resume.data) { %>

                        <a
                            href="/admin/application-resume/<%= application._id %>"
                            target="_blank"
                            class="flex items-center gap-2
                                   border border-gray-300 bg-white
                                   px-4 py-3 rounded-xl
                                   hover:bg-gray-50">

                            <i class="ri-download-2-line"></i>

                            <span class="font-medium">
                                Resume
                            </span>

                        </a>

                    <% } %>


                    <!-- STATUS -->

                    <div class="relative">

                        <button
                            type="button"
                            onclick="document.getElementById('statusMenu').classList.toggle('hidden')"
                            class="flex items-center gap-2
                                   bg-blue-600 text-white
                                   px-4 py-3 rounded-xl
                                   hover:bg-blue-700">

                            <i class="ri-refresh-line"></i>

                            <span>
                                Update Status
                            </span>

                            <i class="ri-arrow-down-s-line"></i>

                        </button>


                        <div
                            id="statusMenu"
                            class="hidden absolute right-0 mt-2
                                   w-48 bg-white border
                                   rounded-xl shadow-xl p-2 z-50">

                            <button
                                onclick="updateStatus('Under Review')"
                                class="w-full text-left px-3 py-2
                                       rounded-lg hover:bg-gray-50">

                                Under Review

                            </button>


                            <button
                                onclick="updateStatus('Shortlisted')"
                                class="w-full text-left px-3 py-2
                                       rounded-lg hover:bg-gray-50">

                                Shortlisted

                            </button>


                            <button
                                onclick="updateStatus('Rejected')"
                                class="w-full text-left px-3 py-2
                                       rounded-lg hover:bg-gray-50">

                                Rejected

                            </button>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================= APPLICANT CARD ================= -->

            <div
                class="bg-white rounded-3xl shadow-xl p-6 md:p-8 mt-8">

                <div
                    class="flex flex-col lg:flex-row
                           items-center gap-6">


                    <!-- PROFILE -->

                    <div
                        class="h-28 w-28 md:h-32 md:w-32
                               rounded-2xl bg-blue-100
                               border-4 border-white shadow-md
                               overflow-hidden
                               flex items-center justify-center shrink-0">

                        <% if (application.applicant &&
                               application.applicant.profileImage &&
                               application.applicant.profileImage.data) { %>

                            <img
                                src="data:<%= application.applicant.profileImage.contentType %>;base64,<%= application.applicant.profileImage.data.toString('base64') %>"
                                class="w-full h-full object-cover"
                                alt="Applicant">

                        <% } else { %>

                            <div
                                class="h-full w-full bg-blue-100
                                       flex items-center justify-center
                                       text-blue-600 text-4xl font-semibold">

                                <%= application.applicant &&
                                    application.applicant.fullname
                                    ? application.applicant.fullname.charAt(0).toUpperCase()
                                    : "U" %>

                            </div>

                        <% } %>

                    </div>


                    <!-- INFO -->

                    <div class="flex-1 w-full">

                        <div
                            class="flex flex-col md:flex-row
                                   md:items-center
                                   md:justify-between gap-3">

                            <div>

                                <h2 class="text-2xl font-bold text-gray-800">

                                    <%= application.applicant.fullname %>

                                </h2>

                                <p class="text-gray-500 font-medium mt-1">

                                    <%= application.previousJobTitle || "Applicant" %>

                                </p>

                            </div>


                            <!-- STATUS -->

                            <span
                                class="inline-flex items-center gap-2
                                       bg-orange-100 text-orange-600
                                       px-4 py-2 rounded-xl
                                       text-sm font-semibold">

                                <i class="ri-time-line"></i>

                                <%= application.status || "Under Review" %>

                            </span>

                        </div>


                        <!-- QUICK DETAILS -->

                        <div
                            class="grid grid-cols-1 sm:grid-cols-2
                                   xl:grid-cols-4 gap-4 mt-5">


                            <div class="flex items-center gap-3">

                                <div
                                    class="w-10 h-10 rounded-xl bg-blue-50
                                           flex items-center justify-center">

                                    <i class="ri-mail-line text-blue-600"></i>

                                </div>

                                <div>

                                    <p class="text-xs text-gray-500">
                                        Email
                                    </p>

                                    <p class="text-sm font-medium">
                                        <%= application.applicant.email %>
                                    </p>

                                </div>

                            </div>


                            <div class="flex items-center gap-3">

                                <div
                                    class="w-10 h-10 rounded-xl bg-green-50
                                           flex items-center justify-center">

                                    <i class="ri-phone-line text-green-600"></i>

                                </div>

                                <div>

                                    <p class="text-xs text-gray-500">
                                        Phone
                                    </p>

                                    <p class="text-sm font-medium">
                                        <%= application.applicant.mobile %>
                                    </p>

                                </div>

                            </div>


                            <div class="flex items-center gap-3">

                                <div
                                    class="w-10 h-10 rounded-xl bg-purple-50
                                           flex items-center justify-center">

                                    <i class="ri-map-pin-line text-purple-600"></i>

                                </div>

                                <div>

                                    <p class="text-xs text-gray-500">
                                        Location
                                    </p>

                                    <p class="text-sm font-medium">

                                        <%= application.applicant.city || "" %>,
                                        <%= application.applicant.state || "" %>

                                    </p>

                                </div>

                            </div>


                            <div class="flex items-center gap-3">

                                <div
                                    class="w-10 h-10 rounded-xl bg-orange-50
                                           flex items-center justify-center">

                                    <i class="ri-calendar-line text-orange-600"></i>

                                </div>

                                <div>

                                    <p class="text-xs text-gray-500">
                                        Applied On
                                    </p>

                                    <p class="text-sm font-medium">

                                        <%= new Date(application.appliedAt)
                                            .toLocaleDateString("en-IN") %>

                                    </p>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================= MAIN GRID ================= -->

            <div
                class="grid grid-cols-1 lg:grid-cols-3
                       gap-6 mt-6">


                <!-- LEFT -->

                <div class="lg:col-span-2 space-y-6">


                    <!-- ABOUT APPLICANT -->

                    <div
                        class="bg-white rounded-3xl shadow-xl
                               p-6 md:p-8">

                        <div
                            class="flex items-center gap-3
                                   pb-4 border-b">

                            <div
                                class="w-10 h-10 rounded-xl
                                       bg-blue-50
                                       flex items-center justify-center">

                                <i class="ri-user-3-line
                                          text-blue-600 text-xl"></i>

                            </div>

                            <h2 class="text-xl font-bold">
                                About the Applicant
                            </h2>

                        </div>


                        <div
                            class="grid grid-cols-1 md:grid-cols-2
                                   gap-x-10 gap-y-5 mt-6">


                            <div>
                                <p class="text-sm text-gray-500">
                                    Full Name
                                </p>

                                <p class="font-medium mt-1">
                                    <%= application.applicant.fullname %>
                                </p>
                            </div>


                            <div>
                                <p class="text-sm text-gray-500">
                                    Email
                                </p>

                                <p class="font-medium text-blue-600 mt-1">
                                    <%= application.applicant.email %>
                                </p>
                            </div>


                            <div>
                                <p class="text-sm text-gray-500">
                                    Phone
                                </p>

                                <p class="font-medium mt-1">
                                    <%= application.applicant.mobile %>
                                </p>
                            </div>


                            <div>
                                <p class="text-sm text-gray-500">
                                    Location
                                </p>

                                <p class="font-medium mt-1">

                                    <%= application.applicant.city || "" %>,
                                    <%= application.applicant.state || "" %>

                                </p>
                            </div>


                            <div>
                                <p class="text-sm text-gray-500">
                                    Current Role
                                </p>

                                <p class="font-medium mt-1">
                                    <%= application.previousJobTitle || "Not Provided" %>
                                </p>
                            </div>


                            <div>
                                <p class="text-sm text-gray-500">
                                    Total Experience
                                </p>

                                <p class="font-medium mt-1">
                                    <%= application.totalExperience || "Not Provided" %>
                                </p>
                            </div>


                            <div>
                                <p class="text-sm text-gray-500">
                                    Current Company
                                </p>

                                <p class="font-medium mt-1">
                                    <%= application.previousCompany || "Not Provided" %>
                                </p>
                            </div>


                            <div>
                                <p class="text-sm text-gray-500">
                                    Expected Salary
                                </p>

                                <p class="font-medium mt-1">
                                    <%= application.expectedSalary || "Not Provided" %>
                                </p>
                            </div>

                        </div>


                        <!-- LINKEDIN -->

                        <div
                            class="mt-6 pt-5 border-t">

                            <p class="text-sm text-gray-500">
                                LinkedIn
                            </p>

                            <% if (application.LinkedIn) { %>

                                <a
                                    href="<%= application.LinkedIn %>"
                                    target="_blank"
                                    class="text-blue-600 font-medium mt-1 inline-flex gap-2">

                                    <%= application.LinkedIn %>

                                    <i class="ri-external-link-line"></i>

                                </a>

                            <% } else { %>

                                <p class="text-gray-400 mt-1">
                                    Not Provided
                                </p>

                            <% } %>

                        </div>

                    </div>


                    <!-- SKILLS -->

                    <div
                        class="bg-white rounded-3xl shadow-xl
                               p-6 md:p-8">

                        <div class="flex items-center gap-3 mb-5">

                            <div
                                class="w-10 h-10 rounded-xl
                                       bg-purple-50
                                       flex items-center justify-center">

                                <i class="ri-code-s-slash-line
                                          text-purple-600 text-xl"></i>

                            </div>

                            <h2 class="text-xl font-bold">
                                Skills
                            </h2>

                        </div>


                        <div class="flex flex-wrap gap-3">

                            <% if (application.applicant &&
                                   application.applicant.skills &&
                                   application.applicant.skills.length) { %>

                                <% application.applicant.skills.forEach(skill => { %>

                                    <span
                                        class="px-4 py-2 bg-gray-100
                                               rounded-xl text-sm
                                               font-medium text-gray-700">

                                        <%= skill %>

                                    </span>

                                <% }) %>

                            <% } else { %>

                                <span class="text-gray-400">
                                    No skills provided
                                </span>

                            <% } %>

                        </div>

                    </div>


                    <!-- COVER LETTER -->

                    <div
                        class="bg-white rounded-3xl shadow-xl
                               p-6 md:p-8">

                        <div
                            class="flex items-center gap-3 mb-5">

                            <div
                                class="w-10 h-10 rounded-xl
                                       bg-blue-50
                                       flex items-center justify-center">

                                <i class="ri-file-text-line
                                          text-blue-600 text-xl"></i>

                            </div>

                            <h2 class="text-xl font-bold">
                                Cover Letter
                            </h2>

                        </div>


                        <div class="max-h-72 overflow-y-auto">

                            <p
                                class="text-gray-600 leading-7
                                       whitespace-pre-line">

                                <%= application.coverLetter ||
                                    "No cover letter provided." %>

                            </p>

                        </div>

                    </div>

                </div>


                <!-- ================= RIGHT ================= -->

                <div class="space-y-6">


                    <!-- APPLICATION SUMMARY -->

                    <div
                        class="bg-white rounded-3xl shadow-xl p-6">

                        <div class="flex items-center gap-3 mb-5">

                            <div
                                class="w-10 h-10 rounded-xl
                                       bg-blue-50
                                       flex items-center justify-center">

                                <i class="ri-file-list-3-line
                                          text-blue-600 text-xl"></i>

                            </div>

                            <h2 class="text-lg font-bold">
                                Application Summary
                            </h2>

                        </div>


                        <div class="space-y-5">


                            <div>

                                <p class="text-sm text-gray-500">
                                    Application ID
                                </p>

                                <p
                                    class="font-medium text-gray-800
                                           mt-1 break-all">

                                    <%= application._id %>

                                </p>

                            </div>


                            <div>

                                <p class="text-sm text-gray-500">
                                    Job Title
                                </p>

                                <p class="font-medium mt-1">

                                    <%= application.job.jobTitle %>

                                </p>

                            </div>


                            <div>

                                <p class="text-sm text-gray-500">
                                    Job Type
                                </p>

                                <p class="font-medium mt-1">

                                    <%= application.job.jobType %>

                                </p>

                            </div>


                            <div>

                                <p class="text-sm text-gray-500">
                                    Company
                                </p>

                                <p class="font-medium mt-1">

                                    <%= application.job.company.companyName %>

                                </p>

                            </div>


                            <div>

                                <p class="text-sm text-gray-500">
                                    Applied On
                                </p>

                                <p class="font-medium mt-1">

                                    <%= new Date(application.appliedAt)
                                        .toLocaleDateString("en-IN") %>

                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- DOCUMENTS -->

                    <div
                        class="bg-white rounded-3xl shadow-xl p-6">

                        <div class="flex items-center gap-3 mb-5">

                            <div
                                class="w-10 h-10 rounded-xl
                                       bg-red-50
                                       flex items-center justify-center">

                                <i class="ri-folder-open-line
                                          text-red-500 text-xl"></i>

                            </div>

                            <h2 class="text-lg font-bold">
                                Documents
                            </h2>

                        </div>


                        <!-- RESUME -->

                        <div
                            class="flex items-center
                                   justify-between p-3
                                   rounded-xl bg-gray-50">

                            <div class="flex items-center gap-3">

                                <div
                                    class="w-10 h-10 rounded-lg
                                           bg-red-100
                                           flex items-center justify-center">

                                    <i class="ri-file-pdf-2-line
                                              text-red-600 text-xl"></i>

                                </div>

                                <div>

                                    <p class="font-medium">
                                        Resume
                                    </p>

                                    <p class="text-xs text-gray-500">
                                        Applicant Resume
                                    </p>

                                </div>

                            </div>


                            <% if (application.resume &&
                                   application.resume.data) { %>

                                <a
                                    href="/admin/application-resume/<%= application._id %>"
                                    target="_blank"
                                    class="w-9 h-9 rounded-lg
                                           bg-white border
                                           flex items-center justify-center">

                                    <i class="ri-download-2-line"></i>

                                </a>

                            <% } else { %>

                                <span class="text-xs text-gray-400">
                                    No Resume
                                </span>

                            <% } %>

                        </div>

                    </div>


                    <!-- CURRENT STATUS -->

                    <div
                        class="bg-white rounded-3xl shadow-xl p-6">

                        <h2 class="text-lg font-bold">
                            Current Status
                        </h2>


                        <div
                            class="mt-4 bg-gray-50
                                   border border-gray-200
                                   rounded-xl px-4 py-4">

                            <p class="text-xs text-gray-400">
                                Application Status
                            </p>

                            <p
                                id="currentStatus"
                                class="text-lg font-semibold mt-1">

                                <%= application.status || "Under Review" %>

                            </p>

                        </div>

                    </div>


                    <!-- DELETE -->

                    <div
                        class="bg-white rounded-3xl shadow-xl p-6">

                        <h2 class="text-lg font-bold mb-4">
                            Admin Actions
                        </h2>


                        <button
                            onclick="deleteApplication()"
                            class="w-full flex items-center
                                   justify-center gap-2
                                   border border-red-400
                                   text-red-600 px-4 py-3
                                   rounded-xl font-medium
                                   hover:bg-red-50">

                            <i class="ri-delete-bin-6-line"></i>

                            Delete Application

                        </button>

                    </div>

                </div>

            </div>

        </main>

    </div>


    <!-- ================= JAVASCRIPT ================= -->

    <script>

        const menubtn = document.querySelector(".menubtn");
        const sidebar = document.querySelector(".sidebar");
        const cross = document.querySelector(".cross");
        const overlay = document.querySelector(".overlay");


        // OPEN SIDEBAR

        menubtn.addEventListener("click", () => {

            sidebar.classList.remove("-translate-x-full");

            overlay.classList.remove("hidden");

        });


        // CLOSE SIDEBAR

        cross.addEventListener("click", () => {

            sidebar.classList.add("-translate-x-full");

            overlay.classList.add("hidden");

        });


        // OVERLAY

        overlay.addEventListener("click", () => {

            sidebar.classList.add("-translate-x-full");

            overlay.classList.add("hidden");

        });


        // UPDATE STATUS

        async function updateStatus(status) {

            try {

                const response = await fetch(
                    `/admin/updateApplicationStatus/<%= application._id %>`,
                    {
                        method: "POST",

                        headers: {
                            "Content-Type": "application/json"
                        },

                        body: JSON.stringify({
                            status: status
                        })
                    }
                );


                const data = await response.json();


                if (data.success) {

                    location.reload();

                } else {

                    alert(data.message);

                }

            } catch (error) {

                console.log(error);

                alert("Something went wrong");

            }

        }


        // DELETE APPLICATION

        function deleteApplication() {

            const confirmDelete = confirm(
                "Are you sure you want to delete this application?"
            );


            if (confirmDelete) {

                window.location.href =
                    `/admin/adminDeleteApplication/<%= application._id %>`;

            }

        }

    </script>

</body>

