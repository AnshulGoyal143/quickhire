<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Applications</title>

    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.6.0/fonts/remixicon.css" rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="overflow-x-hidden bg-gray-50">

    <div class="w-full min-h-screen relative">

        <!-- ================= MAIN WRAPPER ================= -->
        <div class="relative">

            <!-- ================= NAVBAR ================= -->
            <nav class="w-full h-16 bg-gray-100 flex items-center justify-between px-3 py-2 fixed top-0 left-0 z-30">

                <!-- Left -->
                <div class="flex items-center gap-4">

                    <div
                        class="menubtn cursor-pointer w-10 h-10 rounded-lg hover:bg-gray-200 flex items-center justify-center transition">
                        <i class="ri-menu-fill text-2xl text-gray-700"></i>
                    </div>

                    <h2 class="text-lg md:text-xl font-semibold text-gray-800">
                        Applications
                    </h2>

                </div>


                <!-- Right -->
                <div class="flex items-center gap-5">

                    <!-- Notification -->
                    <a href=""
                        class="w-10 h-10 rounded-full hover:bg-gray-200 flex items-center justify-center transition">
                        <i class="ri-notification-3-line text-2xl text-gray-700"></i>
                    </a>


                    <!-- Admin -->
                    <div class="flex items-center gap-2">

                        <div
                            class="h-11 w-11 rounded-full overflow-hidden bg-blue-100 flex items-center justify-center">

                            <% if (admin?.profileImage && admin.profileImage !=="default-admin.png" ) { %>

                                <img src="/admin/admin-profile" alt="Admin Profile" class="w-full h-full object-cover">

                                <% } else { %>

                                    <i class="ri-admin-fill text-2xl text-blue-500"></i>

                                    <% } %>

                        </div>

                        <h2 class="text-xl font-semibold hidden md:block text-gray-800">
                            Admin
                        </h2>

                        <a href="">
                            <i class="ri-arrow-down-wide-line text-gray-600"></i>
                        </a>

                    </div>

                </div>

            </nav>


            <!-- ================= SIDEBAR ================= -->
            <div
                class="sidebar fixed top-0 left-0 w-72 h-screen bg-white shadow-2xl z-[60] -translate-x-full transition-transform duration-300 p-4">

                <!-- Logo -->
                <div class="flex items-center">

                    <img class="h-8"
                        src="https://static.vecteezy.com/system/resources/thumbnails/070/916/787/small/a-3d-render-of-a-light-blue-briefcase-with-the-word-job-in-white-letters-isolated-on-transparent-background-png.png"
                        alt="">

                    <h5 class="text-xl font-bold">
                        Quick <span class="text-blue-500">Hire</span>
                    </h5>

                </div>


                <!-- Close -->
                <div class="cross flex justify-end mb-3">

                    <i
                        class="ri-close-line text-2xl w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center cursor-pointer hover:bg-gray-200">
                    </i>

                </div>


                <!-- Menu -->
                <div class="list">

                    <ul class="space-y-3">

                        <!-- Dashboard -->
                        <li class="flex items-center gap-2 px-4 py-3 rounded-xl cursor-pointer hover:bg-gray-100">

                            <a href="/admin/adminDashboard" class="flex items-center gap-2 w-full">

                                <i class="ri-home-3-line text-xl"></i>
                                <span>Dashboard</span>

                            </a>

                        </li>


                        <!-- Users -->
                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">

                            <a href="/admin/adminUserDashboard" class="flex items-center gap-2 w-full">

                                <i class="ri-group-line text-xl"></i>
                                <span>Users</span>

                            </a>

                        </li>


                        <!-- Companies -->
                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">

                            <a href="/admin/adminCompanyDashboard" class="flex items-center gap-2 w-full">

                                <i class="ri-building-2-line text-xl"></i>
                                <span>Companies</span>

                            </a>

                        </li>


                        <!-- Jobs -->
                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">

                            <a href="/admin/adminJobDashboard" class="flex items-center gap-2 w-full">

                                <i class="ri-briefcase-4-line text-xl"></i>
                                <span>Jobs</span>

                            </a>

                        </li>


                        <!-- Applications Active -->
                        <li
                            class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer bg-blue-100 text-blue-600">

                            <a href="/admin/adminApplicationDashboard" class="flex items-center gap-2 w-full">

                                <i class="ri-file-list-3-line text-xl"></i>
                                <span>Applications</span>

                            </a>

                        </li>


                        <!-- Profile -->
                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">

                            <a href="/admin/adminProfilePage" class="flex items-center gap-2 w-full">

                                <i class="ri-user-line text-xl"></i>
                                <span>My Profile</span>

                            </a>

                        </li>


                        <!-- Logout -->
                        <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer mt-8 hover:bg-gray-100">

                            <a href="/admin/logout" class="flex items-center gap-2 w-full">

                                <i class="ri-logout-box-r-line text-xl"></i>
                                <span>Logout</span>

                            </a>

                        </li>

                    </ul>

                </div>

            </div>


            <!-- ================= OVERLAY ================= -->
            <div class="overlay fixed inset-0 bg-black/30 hidden z-40">
            </div>


            <!-- ================= MAIN CONTENT ================= -->
            <main class="relative z-0 pt-24 pb-12">

                <!-- ================= HEADING ================= -->
                <div class="px-6 sm:px-8 lg:px-12">

                    <div class="mb-8">

                        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-800">

                            Applications

                        </h1>

                        <p class="text-base sm:text-lg text-gray-600 mt-3">

                            Manage and monitor all job applications across Quick Hire.

                        </p>

                    </div>


                    <!-- ================= STAT CARDS ================= -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6">


                        <!-- Total -->
                        <div class="bg-white rounded-3xl shadow-xl p-6 hover:shadow-2xl transition min-h-[155px]">

                            <div class="flex items-center gap-4">

                                <div
                                    class="w-14 h-14 lg:w-16 lg:h-16 rounded-full bg-blue-100 flex items-center justify-center">

                                    <i class="ri-group-line text-3xl lg:text-4xl text-blue-600">
                                    </i>

                                </div>

                                <div>

                                    <p class="text-4xl font-bold text-gray-800">
                                        <%= totalApplications %>
                                    </p>

                                    <p class="text-lg text-gray-500 mt-1 font-semibold">
                                        Total Applications
                                    </p>

                                </div>

                            </div>

                        </div>


                        <!-- Shortlisted -->
                        <div class="bg-white rounded-3xl shadow-xl p-6 hover:shadow-2xl transition min-h-[155px]">

                            <div class="flex items-center gap-4">

                                <div
                                    class="w-14 h-14 lg:w-16 lg:h-16 rounded-full bg-green-100 flex items-center justify-center">

                                    <i class="ri-checkbox-circle-line text-3xl lg:text-4xl text-green-600">
                                    </i>

                                </div>

                                <div>

                                    <p class="text-4xl font-bold text-gray-800">
                                        <%= shortlistedApplication %>
                                    </p>

                                    <p class="text-lg text-gray-500 mt-1 font-semibold">
                                        Shortlisted
                                    </p>

                                </div>

                            </div>

                        </div>


                        <!-- Under Review -->
                        <div class="bg-white rounded-3xl shadow-xl p-6 hover:shadow-2xl transition min-h-[155px]">

                            <div class="flex items-center gap-4">

                                <div
                                    class="w-14 h-14 lg:w-16 lg:h-16 rounded-full bg-orange-100 flex items-center justify-center">

                                    <i class="ri-time-line text-3xl lg:text-4xl text-orange-500">
                                    </i>

                                </div>

                                <div>

                                    <p class="text-4xl font-bold text-gray-800">
                                        <%= reviewApplications %>
                                    </p>

                                    <p class="text-lg text-gray-500 mt-1 font-semibold">
                                        Under Review
                                    </p>

                                </div>

                            </div>

                        </div>


                        <!-- Rejected -->
                        <div class="bg-white rounded-3xl shadow-xl p-6 hover:shadow-2xl transition min-h-[155px]">

                            <div class="flex items-center gap-4">

                                <div
                                    class="w-14 h-14 lg:w-16 lg:h-16 rounded-full bg-red-100 flex items-center justify-center">

                                    <i class="ri-close-circle-line text-3xl lg:text-4xl text-red-600">
                                    </i>

                                </div>

                                <div>

                                    <p class="text-4xl font-bold text-gray-800">
                                        <%= rejectedApplications %>
                                    </p>

                                    <p class="text-lg text-gray-500 mt-1 font-semibold">
                                        Rejected
                                    </p>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ================= APPLICATION SECTION ================= -->
                <div class="px-6 sm:px-8 lg:px-12 mt-10">


                    <!-- Search + Filters -->
                    <div class="bg-white rounded-2xl border border-gray-200 p-4 mb-5">

                        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">

                            <!-- Search -->
                            <div class="relative w-full lg:w-[420px]">

                                <i
                                    class="ri-search-line absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-lg">
                                </i>

                                <input type="text" placeholder="Search applicants, jobs or companies..."
                                    class="w-full border border-gray-300 rounded-xl py-3 pl-12 pr-4 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition">

                            </div>


                            <!-- Filter -->
                            <div class="flex gap-3">

                                <select
                                    class="border border-gray-300 rounded-xl px-4 py-3 outline-none focus:border-blue-500 bg-white">

                                    <option value="">All Companies</option>

                                    <% if (companies) { %>

                                        <% companies.forEach(company=> { %>

                                            <option value="<%= company._id %>">
                                                <%= company.companyName %>
                                            </option>

                                            <% }) %>

                                                <% } %>

                                </select>


                                <select
                                    class="border border-gray-300 rounded-xl px-4 py-3 outline-none focus:border-blue-500 bg-white">

                                    <option value="">All Status</option>
                                    <option value="Under Review">
                                        Under Review
                                    </option>
                                    <option value="Shortlisted">
                                        Shortlisted
                                    </option>
                                    <option value="Rejected">
                                        Rejected
                                    </option>

                                </select>

                            </div>

                        </div>

                    </div>


                    <!-- ================= STATUS TABS ================= -->
                    <div class="border border-gray-200 rounded-2xl p-2 mb-5 bg-white">

                        <div class="flex items-center gap-1 overflow-x-auto">


                            <!-- All -->
                            <button
                                class="status-tab flex items-center gap-2 px-5 py-2.5 rounded-xl bg-blue-600 text-white font-medium text-sm whitespace-nowrap transition">

                                <i class="ri-apps-line"></i>

                                <span>All Applications</span>

                                <span class="bg-white/20 px-2 py-0.5 rounded-full text-xs">

                                    <%= totalApplications %>

                                </span>

                            </button>


                            <!-- Review -->
                            <button
                                class="status-tab flex items-center gap-2 px-5 py-2.5 rounded-xl text-gray-600 hover:bg-gray-100 font-medium text-sm whitespace-nowrap transition">

                                <i class="ri-time-line text-orange-500">
                                </i>

                                <span>Under Review</span>

                                <span class="bg-orange-100 text-orange-600 px-2 py-0.5 rounded-full text-xs">

                                    <%= reviewApplications %>

                                </span>

                            </button>


                            <!-- Shortlisted -->
                            <button
                                class="status-tab flex items-center gap-2 px-5 py-2.5 rounded-xl text-gray-600 hover:bg-gray-100 font-medium text-sm whitespace-nowrap transition">

                                <i class="ri-checkbox-circle-line text-green-500">
                                </i>

                                <span>Shortlisted</span>

                                <span class="bg-green-100 text-green-600 px-2 py-0.5 rounded-full text-xs">

                                    <%= shortlistedApplication %>

                                </span>

                            </button>


                            <!-- Rejected -->
                            <button
                                class="status-tab flex items-center gap-2 px-5 py-2.5 rounded-xl text-gray-600 hover:bg-gray-100 font-medium text-sm whitespace-nowrap transition">

                                <i class="ri-close-circle-line text-red-500">
                                </i>

                                <span>Rejected</span>

                                <span class="bg-red-100 text-red-600 px-2 py-0.5 rounded-full text-xs">

                                    <%= rejectedApplications %>

                                </span>

                            </button>

                        </div>

                    </div>


                    <!-- ================= TABLE ================= -->
                    <div class="bg-white rounded-3xl shadow-lg border border-gray-200 overflow-hidden">

                        <div class="overflow-x-auto">

                            <table class="w-full min-w-[1150px]">

                                <thead class="bg-gray-50 border-b">

                                    <tr>

                                        <th class="text-left px-6 py-4 text-sm font-semibold text-gray-600">
                                            Candidate
                                        </th>

                                        <th class="text-left px-6 py-4 text-sm font-semibold text-gray-600">
                                            Job Title
                                        </th>

                                        <th class="text-left px-6 py-4 text-sm font-semibold text-gray-600">
                                            Company
                                        </th>

                                        <th class="text-left px-6 py-4 text-sm font-semibold text-gray-600">
                                            Applied On
                                        </th>

                                        <th class="text-left px-6 py-4 text-sm font-semibold text-gray-600">
                                            Status
                                        </th>

                                        <th class="text-center px-6 py-4 text-sm font-semibold text-gray-600">
                                            Actions
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    <% if (applications && applications.length> 0) { %>

                                        <% applications.forEach(application=> { %>

                                            <tr class="border-b hover:bg-gray-50 transition">


                                                <!-- Candidate -->
                                                <td class="px-6 py-5">

                                                    <div class="flex items-center gap-4">

                                                        <div
                                                            class="h-14 w-14 bg-blue-100 rounded-full flex items-center justify-center overflow-hidden">

                                                            <% if ( application.applicant &&
                                                                application.applicant.profileImage &&
                                                                application.applicant.profileImage.data ) { %>

                                                                <img src="data:<%= application.applicant.profileImage.contentType %>;base64,<%= application.applicant.profileImage.data.toString('base64') %>"
                                                                    alt="Profile"
                                                                    class="h-14 w-14 rounded-full object-cover">

                                                                <% } else { %>

                                                                    <div
                                                                        class="h-14 w-14 bg-blue-100 rounded-full flex items-center justify-center text-blue-600 font-semibold text-lg">

                                                                        <%= application.applicant &&
                                                                            application.applicant.fullname ?
                                                                            application.applicant.fullname.charAt(0).toUpperCase()
                                                                            : "U" %>

                                                                    </div>

                                                                    <% } %>

                                                        </div>


                                                        <div>

                                                            <h2 class="font-medium text-gray-800">

                                                                <%= application.applicant?.fullname || "Unknown User" %>

                                                            </h2>

                                                            <p class="text-gray-500 mt-1 text-sm">

                                                                <%= application.applicant?.email || "No email" %>

                                                            </p>

                                                        </div>

                                                    </div>

                                                </td>


                                                <!-- Job -->
                                                <td class="px-6 py-5">

                                                    <div>

                                                        <h2 class="font-medium text-gray-800">

                                                            <%= application.job?.jobTitle || "Unknown Job" %>

                                                        </h2>

                                                        <p class="text-gray-500 mt-1">

                                                            <%= application.job?.jobType || "N/A" %>

                                                        </p>

                                                    </div>

                                                </td>


                                                <!-- Company -->
                                                <td class="px-6 py-5">

                                                    <div class="flex items-center gap-3">

                                                        <div
                                                            class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center">

                                                            <i class="ri-building-4-line text-xl text-blue-500">
                                                            </i>

                                                        </div>

                                                        <div>

                                                            <p class="font-medium text-gray-800">

                                                                <%= application.job?.company?.companyName ||
                                                                    application.company?.companyName
                                                                    || "Unknown Company" %>

                                                            </p>

                                                        </div>

                                                    </div>

                                                </td>


                                                <!-- Date -->
                                                <td class="px-6 py-5 text-gray-600">

                                                    <%= new Date(application.appliedAt).toLocaleDateString( "en-IN" , {
                                                        day: "2-digit" , month: "short" , year: "numeric" } ) %>

                                                </td>


                                                <!-- Status -->
                                                <td class="px-6 py-5">

                                                    <% if (application.status==="Shortlisted" ) { %>

                                                        <span
                                                            class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-xs font-semibold">

                                                            Shortlisted

                                                        </span>

                                                        <% } else if (application.status==="Rejected" ) { %>

                                                            <span
                                                                class="bg-red-100 text-red-700 px-3 py-1 rounded-full text-xs font-semibold">

                                                                Rejected

                                                            </span>

                                                            <% } else { %>

                                                                <span
                                                                    class="bg-orange-100 text-orange-700 px-3 py-1 rounded-full text-xs font-semibold">

                                                                    Under Review

                                                                </span>

                                                                <% } %>

                                                </td>


                                                <!-- Actions -->
                                                <td class="px-6 py-5">

                                                    <div class="flex justify-center gap-2">

                                                        <!-- View -->
                                                        <a href="/admin/adminApplicationDetails/<%= application._id %>"
                                                            title="View Details"
                                                            class="w-9 h-9 rounded-lg bg-blue-50 text-blue-600 hover:bg-blue-100 transition flex items-center justify-center">

                                                            <i class="ri-eye-line"></i>

                                                        </a>


                                                        <!-- Delete -->
                                                        <!-- Delete -->
                                                        <button type="button" title="Delete Application"
                                                            data-id="<%= application._id %>"
                                                            data-name="<%= application.applicant?.fullname || 'Unknown User' %>"
                                                            onclick="openDeleteModal(this.dataset.id, this.dataset.name)"
                                                            class="w-9 h-9 rounded-lg bg-red-50 text-red-600 hover:bg-red-100 transition flex items-center justify-center">

                                                            <i class="ri-delete-bin-6-line"></i>

                                                        </button>

                                                    </div>

                                                </td>

                                            </tr>

                                            <% }) %>

                                                <% } else { %>

                                                    <tr>

                                                        <td colspan="6" class="px-6 py-12 text-center">

                                                            <div class="flex flex-col items-center justify-center">

                                                                <div
                                                                    class="w-16 h-16 rounded-full bg-gray-100 flex items-center justify-center mb-4">

                                                                    <i
                                                                        class="ri-file-list-3-line text-3xl text-gray-400">
                                                                    </i>

                                                                </div>

                                                                <h3 class="text-lg font-semibold text-gray-700">

                                                                    No Applications Found

                                                                </h3>

                                                                <p class="text-sm text-gray-500 mt-1">

                                                                    There are no job applications available yet.

                                                                </p>

                                                            </div>

                                                        </td>

                                                    </tr>

                                                    <% } %>

                                </tbody>

                            </table>

                        </div>


                        <!-- ================= PAGINATION ================= -->
                        <div
                            class="flex flex-col md:flex-row items-center justify-between gap-4 px-6 py-4 border-t bg-white">

                            <p class="text-sm text-gray-500">

                                Showing
                                <span class="font-semibold">
                                    <%= applications ? applications.length : 0 %>
                                </span>
                                applications

                            </p>


                            <div class="flex items-center gap-2">

                                <button class="w-9 h-9 rounded-lg border hover:bg-gray-100">

                                    <i class="ri-arrow-left-s-line"></i>

                                </button>

                                <button class="w-9 h-9 rounded-lg bg-blue-600 text-white">

                                    1

                                </button>

                                <button class="w-9 h-9 rounded-lg border hover:bg-gray-100">

                                    2

                                </button>

                                <button class="w-9 h-9 rounded-lg border hover:bg-gray-100">

                                    3

                                </button>

                                <button class="w-9 h-9 rounded-lg border hover:bg-gray-100">

                                    <i class="ri-arrow-right-s-line"></i>

                                </button>

                            </div>

                        </div>

                        
                        <!-- ================= DELETE CONFIRMATION MODAL ================= -->

                        <div id="deleteModal"
                            class="fixed inset-0 bg-black/40 hidden items-center justify-center z-[100]">

                            <div class="bg-white rounded-2xl shadow-2xl w-[90%] max-w-md p-6">

                                <!-- Icon -->
                                <div class="w-14 h-14 mx-auto rounded-full bg-red-100
                    flex items-center justify-center mb-4">

                                    <i class="ri-delete-bin-6-line text-3xl text-red-600"></i>

                                </div>

                                <!-- Heading -->
                                <h2 class="text-xl font-bold text-gray-800 text-center">
                                    Delete Application?
                                </h2>

                                <!-- Message -->
                                <p class="text-gray-500 text-center mt-2">
                                    Are you sure you want to delete the application of
                                    <span id="applicantName" class="font-semibold text-gray-700">
                                    </span>?
                                </p>

                                <p class="text-sm text-red-500 text-center mt-2">
                                    This action cannot be undone.
                                </p>

                                <!-- Buttons -->
                                <div class="flex justify-center gap-3 mt-6">

                                    <!-- Cancel -->
                                    <button onclick="closeDeleteModal()" class="px-5 py-2.5 rounded-xl border border-gray-300
                       text-gray-700 hover:bg-gray-100 transition">

                                        Cancel
                                    </button>

                                    <!-- Delete -->
                                    <button onclick="confirmDelete()" class="px-5 py-2.5 rounded-xl bg-red-600 text-white
                       hover:bg-red-700 transition">

                                        Yes, Delete
                                    </button>

                                </div>

                            </div>
                        </div>

                    </div>

                </div>

            </main>

        </div>

    </div>


    <!-- ================= JAVASCRIPT ================= -->
    <script>

        const menubtn = document.querySelector(".menubtn");
        const sidebar = document.querySelector(".sidebar");
        const cross = document.querySelector(".cross");
        const overlay = document.querySelector(".overlay");


        // Open Sidebar
        menubtn.addEventListener("click", () => {

            sidebar.classList.remove("-translate-x-full");
            overlay.classList.remove("hidden");

        });


        // Close Sidebar
        cross.addEventListener("click", () => {

            sidebar.classList.add("-translate-x-full");
            overlay.classList.add("hidden");

        });


        // Close on Overlay Click
        overlay.addEventListener("click", () => {

            sidebar.classList.add("-translate-x-full");
            overlay.classList.add("hidden");

        });

        let deleteApplicationId = "";

        function openDeleteModal(applicationId, applicantName) {

            deleteApplicationId = applicationId;

            document.getElementById("applicantName").textContent = applicantName;

            const modal = document.getElementById("deleteModal");

            modal.classList.remove("hidden");
            modal.classList.add("flex");
        }


        function closeDeleteModal() {

            const modal = document.getElementById("deleteModal");

            modal.classList.add("hidden");
            modal.classList.remove("flex");

            deleteApplicationId = "";
        }


       function confirmDelete() {

    if (deleteApplicationId) {

        window.location.href =
            "/admin/adminDeleteApplication/" +
            deleteApplicationId;

    }

}

    </script>

</body>

</html>