```html
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= company.companyName %> - Company Profile</title>

    <!-- Remix Icons -->
    <link
        href="https://cdn.jsdelivr.net/npm/remixicon@4.6.0/fonts/remixicon.css"
        rel="stylesheet"
    >

    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>


<body class="bg-slate-50 text-gray-800 overflow-x-hidden">


<!-- ========================================================= -->
 <nav class="w-full h-16 bg-gray-100 flex items-center justify-between px-3 py-2 fixed top-0">
            <div class="flex items-center justify-between sm:gap-4 lg:gap-6">
                <div class="menubtn">
                    <i class="ri-menu-fill text-2xl"></i>
                </div>
                <h2 class="text-lg md:text-xl font-semibold text-gray-800 ml-2">Dashboard</h2>
            </div>
            <div class="flex items-center gap-6">
                <!-- notification k ley route bnana h -->
                <a href=""><i class="ri-notification-3-line text-2xl"></i>
                </a>
                <div class="flex items-center gap-2">
                    <img class="h-10 w-11 rounded-full"
                        src="https://static.vecteezy.com/system/resources/thumbnails/053/964/117/small/a-silhouette-of-a-person-with-a-circular-head-and-a-minimalistic-body-structure-showcasing-a-simple-design-png.png"
                        alt="">
                    <h2 class="text-xl font-semibold hidden md:block ">Admin</h2>
                    <a href=""><i class="ri-arrow-down-wide-line"></i></a>
                </div>
            </div>
        </nav>
        <!-- *********** FOr the menu list div ********-->
        <div
            class=" sidebar fixed top-0 left-0 w-72 h-screen bg-white shadow-2xl z-50 -translate-x-full transition-transform duration-300 p-4">

            <div class="flex items-center ">
                <img class="h-8"
                    src="https://static.vecteezy.com/system/resources/thumbnails/070/916/787/small/a-3d-render-of-a-light-blue-briefcase-with-the-word-job-in-white-letters-isolated-on-transparent-background-png.png"
                    alt="">
                <h5 class="text-xl font-bold">Quick <span class="text-blue-500">Hire</span></h5>
            </div>
            <div class="cross flex justify-end ">
                <i
                    class="ri-close-line text-2xl w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center cursor-pointer hover:bg-gray-200"></i>
            </div>
            <div class="list">
                <ul class=" space-y-3">
                    <!-- yha pee user dashboard menu link attach krne h -->

                    <li class="flex items-center gap-2 px-4 py-3 rounded-xl cursor-pointer hover:bg-gray-100 mb-1 mt-1">
                        <a href="/users/userDashboard">
                            <i class="ri-home-3-line text-xl"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>


                    <li
                        class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer  bg-blue-100 text-blue-600  ">
                        <a href="/users/userMyApplications">
                            <i class="ri-file-list-3-line text-xl"></i>
                            <span>My Applications</span>
                        </a>
                    </li>

                    <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100 ">
                        <a href="/users/userBrowseJobs">
                            <i class="ri-briefcase-line text-xl"></i>
                            <span>Browse Jobs</span>
                        </a>
                    </li>

                    <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">
                        <a href="/users/userProfile">
                            <i class="ri-user-3-line text-xl"></i>
                            <span>My Profile</span>
                        </a>
                    </li>

                    <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer hover:bg-gray-100">
                        <a href="/users/ProfileEdit">
                            <i class="ri-edit-2-line text-xl"></i>
                            <span>Edit Profile</span>
                        </a>
                    </li>

                    <li class="flex items-center gap-2 px-4 py-4 rounded-xl cursor-pointer mt-8 hover:bg-gray-100">
                        <a href="/logout">
                            <i class="ri-logout-box-r-line text-xl"></i>
                            <span>Logout</span>
                        </a>
                    </li>


                </ul>
            </div>
        </div>



<!-- ========================================================= -->
<!-- MAIN -->
<!-- ========================================================= -->

<main class="pt-16 min-h-screen">


    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

        <!-- ================================================= -->
        <!-- COMPANY HEADER -->
        <!-- ================================================= -->

        <section
            class="bg-white rounded-3xl border border-gray-200 shadow-sm overflow-hidden p-6
            ">


            <!-- COMPANY INFO -->

            <div class="px-5 sm:px-8 lg:px-10">


                <div
                    class="flex flex-col md:flex-row md:items-end gap-5" >


                    <!-- COMPANY LOGO -->

                    <div class="-mt-12 sm:-mt-14 relative z-10">

                        <div
                            class="w-24 h-24 sm:w-28 sm:h-28
                            md:w-32 md:h-32
                            rounded-2xl bg-white
                            p-2 shadow-lg border border-gray-100"
                        >

                            <div
                                class="w-full h-full rounded-xl
                                bg-gray-50 overflow-hidden
                                flex items-center justify-center"
                            >

                                <img
                                    src="/users/company-profile/<%= company._id %>"
                                    alt="<%= company.companyName %>"
                                    class="w-full h-full object-cover"
                                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                                >


                                <!-- FALLBACK -->

                                <div
                                    class="hidden w-full h-full
                                    items-center justify-center
                                    bg-blue-50"
                                >

                                    <i
                                        class="ri-building-4-line
                                        text-5xl text-blue-500"
                                    ></i>

                                </div>

                            </div>

                        </div>

                    </div>



                    <!-- COMPANY NAME -->

                    <div class="flex-1 pb-7 pt-1">


                        <div
                            class="flex flex-col lg:flex-row
                            lg:items-end lg:justify-between gap-5"
                        >


                            <div>

                                <h1
                                    class="text-2xl sm:text-3xl
                                    md:text-4xl font-bold
                                    text-gray-900"
                                >
                                    <%= company.companyName %>
                                </h1>


                                <p
                                    class="text-gray-500 mt-1
                                    text-base sm:text-lg"
                                >
                                    <%= company.industry %>
                                </p>


                                <div
                                    class="flex flex-wrap
                                    items-center gap-4 mt-4"
                                >

                                    <span
                                        class="flex items-center gap-2
                                        text-sm text-gray-600"
                                    >

                                        <i
                                            class="ri-map-pin-line
                                            text-blue-600"
                                        ></i>

                                        <%= company.location %>

                                    </span>


                                    <span
                                        class="flex items-center gap-2
                                        text-sm text-gray-600"
                                    >

                                        <i
                                            class="ri-team-line
                                            text-blue-600"
                                        ></i>

                                        <%= company.companySize %>

                                    </span>

                                </div>

                            </div>


                            <!-- STATUS -->

                            <div>

                                <span
                                    class="inline-flex items-center
                                    gap-2 px-4 py-2
                                    rounded-full
                                    bg-green-50 text-green-700
                                    border border-green-100
                                    text-sm font-semibold"
                                >

                                    <span
                                        class="w-2 h-2
                                        rounded-full bg-green-500"
                                    ></span>

                                    Hiring Company

                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </section>



        <!-- ================================================= -->
        <!-- CONTENT -->
        <!-- ================================================= -->

        <div
            class="grid grid-cols-1 lg:grid-cols-3
            gap-7 mt-7"
        >


            <!-- ================================================= -->
            <!-- LEFT -->
            <!-- ================================================= -->

            <div class="lg:col-span-2 space-y-7">


                <!-- ABOUT -->

                <section
                    class="bg-white rounded-2xl
                    border border-gray-200
                    shadow-sm p-6 sm:p-8"
                >

                    <div
                        class="flex items-center gap-3 mb-6"
                    >

                        <div
                            class="w-10 h-10 rounded-xl
                            bg-blue-50
                            flex items-center justify-center"
                        >

                            <i
                                class="ri-information-line
                                text-xl text-blue-600"
                            ></i>

                        </div>


                        <div>

                            <h2
                                class="text-xl font-bold
                                text-gray-900"
                            >
                                About Company
                            </h2>

                            <p class="text-sm text-gray-500">
                                Learn more about this organization
                            </p>

                        </div>

                    </div>


                    <p
                        class="text-gray-600 leading-7 text-[15px]"
                    >

                        <%= company.about ||
                        "No information available about this company." %>

                    </p>

                </section>



                <!-- COMPANY INFORMATION -->

                <section
                    class="bg-white rounded-2xl
                    border border-gray-200
                    shadow-sm overflow-hidden"
                >


                    <!-- Heading -->

                    <div class="px-6 sm:px-8 pt-7 pb-5">

                        <h2
                            class="text-xl font-bold
                            text-gray-900"
                        >
                            Company Information
                        </h2>

                        <p class="text-sm text-gray-500 mt-1">
                            Basic information about the company
                        </p>

                    </div>



                    <!-- Information rows -->

                    <div class="divide-y divide-gray-100">


                        <!-- COMPANY NAME -->

                        <div
                            class="px-6 sm:px-8 py-5
                            flex flex-col sm:flex-row
                            sm:items-center"
                        >

                            <div class="sm:w-1/3">

                                <p class="text-sm text-gray-500">
                                    Company Name
                                </p>

                            </div>

                            <div class="sm:w-2/3 mt-1 sm:mt-0">

                                <p
                                    class="font-semibold
                                    text-gray-800"
                                >
                                    <%= company.companyName %>
                                </p>

                            </div>

                        </div>



                        <!-- INDUSTRY -->

                        <div
                            class="px-6 sm:px-8 py-5
                            flex flex-col sm:flex-row
                            sm:items-center"
                        >

                            <div class="sm:w-1/3">

                                <p class="text-sm text-gray-500">
                                    Industry
                                </p>

                            </div>

                            <div class="sm:w-2/3 mt-1 sm:mt-0">

                                <p class="font-medium text-gray-800">
                                    <%= company.industry %>
                                </p>

                            </div>

                        </div>



                        <!-- COMPANY SIZE -->

                        <div
                            class="px-6 sm:px-8 py-5
                            flex flex-col sm:flex-row
                            sm:items-center"
                        >

                            <div class="sm:w-1/3">

                                <p class="text-sm text-gray-500">
                                    Company Size
                                </p>

                            </div>

                            <div class="sm:w-2/3 mt-1 sm:mt-0">

                                <p class="font-medium text-gray-800">
                                    <%= company.companySize %>
                                </p>

                            </div>

                        </div>



                        <!-- FOUNDED -->

                        <div
                            class="px-6 sm:px-8 py-5
                            flex flex-col sm:flex-row
                            sm:items-center"
                        >

                            <div class="sm:w-1/3">

                                <p class="text-sm text-gray-500">
                                    Founded Year
                                </p>

                            </div>

                            <div class="sm:w-2/3 mt-1 sm:mt-0">

                                <p class="font-medium text-gray-800">
                                    <%= company.foundedYear %>
                                </p>

                            </div>

                        </div>



                        <!-- LOCATION -->

                        <div
                            class="px-6 sm:px-8 py-5
                            flex flex-col sm:flex-row
                            sm:items-center"
                        >

                            <div class="sm:w-1/3">

                                <p class="text-sm text-gray-500">
                                    Location
                                </p>

                            </div>

                            <div class="sm:w-2/3 mt-1 sm:mt-0">

                                <p
                                    class="font-medium text-gray-800
                                    flex items-center gap-2"
                                >

                                    <i
                                        class="ri-map-pin-line
                                        text-blue-600"
                                    ></i>

                                    <%= company.location %>

                                </p>

                            </div>

                        </div>



                        <!-- PHONE -->

                        <div
                            class="px-6 sm:px-8 py-5
                            flex flex-col sm:flex-row
                            sm:items-center"
                        >

                            <div class="sm:w-1/3">

                                <p class="text-sm text-gray-500">
                                    Phone
                                </p>

                            </div>

                            <div class="sm:w-2/3 mt-1 sm:mt-0">

                                <p
                                    class="font-medium text-gray-800"
                                >
                                    <%= company.phone %>
                                </p>

                            </div>

                        </div>



                        <!-- EMAIL -->

                        <div
                            class="px-6 sm:px-8 py-5
                            flex flex-col sm:flex-row
                            sm:items-center"
                        >

                            <div class="sm:w-1/3">

                                <p class="text-sm text-gray-500">
                                    Email
                                </p>

                            </div>

                            <div class="sm:w-2/3 mt-1 sm:mt-0">

                                <p
                                    class="font-medium
                                    text-gray-800 break-all"
                                >
                                    <%= company.companyEmail %>
                                </p>

                            </div>

                        </div>



                        <!-- WEBSITE -->

                        <div
                            class="px-6 sm:px-8 py-5
                            flex flex-col sm:flex-row
                            sm:items-center"
                        >

                            <div class="sm:w-1/3">

                                <p class="text-sm text-gray-500">
                                    Website
                                </p>

                            </div>

                            <div class="sm:w-2/3 mt-1 sm:mt-0">

                                <% if (company.website) { %>

                                    <a
                                        href="<%= company.website %>"
                                        target="_blank"
                                        class="inline-flex items-center
                                        gap-2 text-blue-600
                                        hover:text-blue-700
                                        font-medium break-all"
                                    >

                                        <%= company.website %>

                                        <i
                                            class="ri-external-link-line"
                                        ></i>

                                    </a>

                                <% } else { %>

                                    <span class="text-gray-400">
                                        Not provided
                                    </span>

                                <% } %>

                            </div>

                        </div>


                    </div>

                </section>

            </div>



            <!-- ================================================= -->
            <!-- RIGHT SIDEBAR -->
            <!-- ================================================= -->

            <div class="space-y-7">


                <!-- COMPANY OVERVIEW -->

                <section
                    class="bg-white rounded-2xl
                    border border-gray-200
                    shadow-sm p-6"
                >

                    <h2
                        class="text-lg font-bold
                        text-gray-900"
                    >
                        Company Overview
                    </h2>

                    <p
                        class="text-sm text-gray-500 mt-1 mb-6"
                    >
                        Quick company details
                    </p>



                    <div class="space-y-5">


                        <!-- INDUSTRY -->

                        <div class="flex items-center gap-4">

                            <div
                                class="w-11 h-11 rounded-xl
                                bg-blue-50
                                flex items-center justify-center
                                flex-shrink-0"
                            >

                                <i
                                    class="ri-briefcase-line
                                    text-xl text-blue-600"
                                ></i>

                            </div>

                            <div>

                                <p class="text-xs text-gray-500">
                                    Industry
                                </p>

                                <p
                                    class="font-semibold
                                    text-gray-800 mt-0.5"
                                >
                                    <%= company.industry %>
                                </p>

                            </div>

                        </div>



                        <!-- SIZE -->

                        <div class="flex items-center gap-4">

                            <div
                                class="w-11 h-11 rounded-xl
                                bg-indigo-50
                                flex items-center justify-center
                                flex-shrink-0"
                            >

                                <i
                                    class="ri-team-line
                                    text-xl text-indigo-600"
                                ></i>

                            </div>

                            <div>

                                <p class="text-xs text-gray-500">
                                    Company Size
                                </p>

                                <p
                                    class="font-semibold
                                    text-gray-800 mt-0.5"
                                >
                                    <%= company.companySize %>
                                </p>

                            </div>

                        </div>



                        <!-- FOUNDED -->

                        <div class="flex items-center gap-4">

                            <div
                                class="w-11 h-11 rounded-xl
                                bg-purple-50
                                flex items-center justify-center
                                flex-shrink-0"
                            >

                                <i
                                    class="ri-calendar-line
                                    text-xl text-purple-600"
                                ></i>

                            </div>

                            <div>

                                <p class="text-xs text-gray-500">
                                    Founded
                                </p>

                                <p
                                    class="font-semibold
                                    text-gray-800 mt-0.5"
                                >
                                    <%= company.foundedYear %>
                                </p>

                            </div>

                        </div>



                        <!-- LOCATION -->

                        <div class="flex items-center gap-4">

                            <div
                                class="w-11 h-11 rounded-xl
                                bg-orange-50
                                flex items-center justify-center
                                flex-shrink-0"
                            >

                                <i
                                    class="ri-map-pin-line
                                    text-xl text-orange-600"
                                ></i>

                            </div>

                            <div>

                                <p class="text-xs text-gray-500">
                                    Location
                                </p>

                                <p
                                    class="font-semibold
                                    text-gray-800 mt-0.5"
                                >
                                    <%= company.location %>
                                </p>

                            </div>

                        </div>


                    </div>

                </section>



                <!-- CONTACT -->

                <section
                    class="bg-white rounded-2xl
                    border border-gray-200
                    shadow-sm p-6"
                >

                    <h2
                        class="text-lg font-bold
                        text-gray-900"
                    >
                        Contact Company
                    </h2>

                    <p
                        class="text-sm text-gray-500 mt-1 mb-6"
                    >
                        Get in touch with the company
                    </p>



                    <div class="space-y-4">


                        <!-- EMAIL -->

                        <div
                            class="flex items-start gap-3
                            p-3 rounded-xl
                            bg-gray-50"
                        >

                            <div
                                class="w-9 h-9 rounded-lg
                                bg-white
                                flex items-center justify-center
                                flex-shrink-0"
                            >

                                <i
                                    class="ri-mail-line
                                    text-blue-600"
                                ></i>

                            </div>

                            <div class="min-w-0">

                                <p class="text-xs text-gray-500">
                                    Email
                                </p>

                                <p
                                    class="text-sm font-medium
                                    text-gray-800 break-all mt-0.5"
                                >
                                    <%= company.companyEmail %>
                                </p>

                            </div>

                        </div>



                        <!-- PHONE -->

                        <div
                            class="flex items-start gap-3
                            p-3 rounded-xl
                            bg-gray-50"
                        >

                            <div
                                class="w-9 h-9 rounded-lg
                                bg-white
                                flex items-center justify-center
                                flex-shrink-0"
                            >

                                <i
                                    class="ri-phone-line
                                    text-blue-600"
                                ></i>

                            </div>

                            <div>

                                <p class="text-xs text-gray-500">
                                    Phone
                                </p>

                                <p
                                    class="text-sm font-medium
                                    text-gray-800 mt-0.5"
                                >
                                    <%= company.phone %>
                                </p>

                            </div>

                        </div>


                    </div>

                </section>



                <!-- BACK BUTTON -->

                <a
                    href="/users/userBrowseJobs"
                    class="w-full h-12 rounded-xl
                    bg-blue-600 hover:bg-blue-700
                    text-white font-semibold
                    flex items-center justify-center
                    gap-2 transition shadow-sm"
                >

                    <i class="ri-arrow-left-line text-lg"></i>

                    Back to Jobs

                </a>


            </div>

        </div>

    </div>

</main>



<!-- ========================================================= -->
<!-- SIDEBAR SCRIPT -->
<!-- ========================================================= -->

<script>

    const menuBtn = document.querySelector(".menubtn");
    const closeBtn = document.querySelector(".cross");
    const sidebar = document.querySelector(".sidebar");


    menuBtn.addEventListener("click", function () {

        sidebar.classList.remove("-translate-x-full");

    });


    closeBtn.addEventListener("click", function () {

        sidebar.classList.add("-translate-x-full");

    });

</script>


</body>

</html>
```
